---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import HowItWorksSteps from '../components/HowItWorksSteps.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { url } from '../lib/url';
import { waMessages } from '../lib/whatsapp';

const [first, second] = site.fee.payments;
const lower = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);

const prepare = [
  'Your expected arrival date, even if it is only approximate.',
  'Where in Ireland you are going, and your college or course if you have one.',
  'Whether an agency is helping you, or you are arranging everything yourself.',
  'Which kinds of help you want, for example accommodation or IRP registration.',
  'Any deadlines you already know about.',
];

const afterEnquiry = [
  {
    title: 'We read your enquiry',
    text: `We reply personally, by WhatsApp or by email, using the details you gave.${site.responseTime ? ` ${site.responseTime}` : ''}`,
  },
  { title: 'We talk it through', text: 'A short conversation about your plans, what we can help with and what we cannot.' },
  { title: 'You decide', text: 'If you want to go ahead, we agree the plan and the payment terms. If not, there is no cost and no obligation.' },
];

const phases: { id: string; icon: string; title: string; items: { text: string; payment?: boolean }[] }[] = [
  {
    id: 'before',
    icon: 'plane',
    title: 'Before you travel',
    items: [
      { text: `First payment: ${lower(first.when)}`, payment: true },
      { text: 'Arrival planning: your flight details, an arrival checklist and how to get from the airport to your accommodation.' },
      { text: 'Accommodation help: understanding your options, checking listings and avoiding scams.' },
    ],
  },
  {
    id: 'arrival',
    icon: 'plane-landing',
    title: 'When you arrive',
    items: [
      { text: 'WhatsApp support as you travel and land.' },
      { text: 'Getting your phone working and settling into your accommodation.' },
      { text: 'Finding the essentials near you: shops, pharmacy and transport.' },
    ],
  },
  {
    id: 'first-weeks',
    icon: 'compass',
    title: 'Your first weeks',
    items: [
      { text: 'Guidance on IRP registration, your PPS Number, a bank account and a TFI Leap Card.' },
      { text: `Local orientation, and WhatsApp support ${site.supportPeriod}.` },
      { text: `Second payment: ${lower(second.when)} ${site.fee.milestoneNote}`, payment: true },
    ],
  },
];
---

<BaseLayout
  title="How It Works | Settle in Ireland"
  description="How our one-to-one arrival and settling-in support works: four simple steps, what to prepare before you get in touch, and what happens next."
>
  <PageHero
    eyebrow="How it works"
    title="From first message to settled in"
    intro="Four simple steps, with no commitment until you have agreed the plan and the price."
    crumbs={[{ label: 'How It Works', href: '/how-it-works/' }]}
  />

  <section class="section" aria-labelledby="steps-heading">
    <div class="container-site">
      <SectionHeading id="steps-heading" eyebrow="The steps" title="Four simple steps" />
      <HowItWorksSteps class="mt-10" />
    </div>
  </section>

  <section class="section bg-white" aria-label="Before and after you get in touch">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <h2 class="text-[1.7rem] sm:text-[2rem]">What to have ready</h2>
        <p class="mt-3">You do not need everything at once. These details help us reply with useful information.</p>
        <ul class="check-list mt-6">
          {prepare.map((p) => <li>{p}</li>)}
        </ul>
        <p class="mt-6 flex gap-2.5 rounded-lg bg-sand p-4 text-[0.95rem] text-ink">
          <Icon name="lock" size={18} class="mt-0.5 shrink-0 text-brand-700" />
          <span>Please do not send passport numbers, immigration documents or bank details in your first message.</span>
        </p>
      </div>
      <div>
        <h2 class="text-[1.7rem] sm:text-[2rem]">What happens after you enquire</h2>
        <ol class="mt-6 grid gap-4">
          {
            afterEnquiry.map((step, i) => (
              <li class="flex gap-4 rounded-xl border border-line bg-canvas p-5">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-900 font-display font-bold text-white">{i + 1}</span>
                <div>
                  <h3 class="text-[1.05rem]">{step.title}</h3>
                  <p class="mt-1 text-[0.97rem]">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={url('/contact/#enquiry')} class="btn btn-primary">Plan My Arrival</a>
          <WhatsAppButton message={waMessages.client} track="how_it_works" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-heading">
    <div class="container-site">
      <SectionHeading
        id="timeline-heading"
        eyebrow="Once you have started"
        title="What the support looks like"
        intro="The support follows your move, from before you travel to your first weeks in Ireland."
      />
      <ol class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          phases.map((phase, i) => (
            <li id={phase.id} class="lift rounded-xl border border-line bg-white p-6 sm:p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <div class="flex items-center gap-3">
                <span class="icon-tile">
                  <Icon name={phase.icon} size={22} />
                </span>
                <h3 class="text-[1.2rem]">{phase.title}</h3>
              </div>
              <ul class="mt-5 grid gap-3">
                {phase.items.map((item) => (
                  <li class:list={['flex gap-3 text-[0.97rem]', item.payment && 'rounded-lg bg-gold-50 p-3 text-ink']}>
                    <Icon name={item.payment ? 'euro' : 'check'} size={18} class:list={['mt-1 shrink-0', item.payment ? 'text-gold-800' : 'text-accent-700']} />
                    <span>{item.text}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <p class="mt-8">
        The price and payment details are on the
        <a href={url('/moving-to-ireland-on-your-own/#package')} class="font-semibold text-accent-700 underline">Moving on Your Own</a> page. Are you an
        education agency? See how referrals work on the
        <a href={url('/agency-partnerships/')} class="font-semibold text-accent-700 underline">Education Agencies</a> page.
      </p>
    </div>
  </section>

  <CTASection
    title="Moving to Ireland soon?"
    text="Send us a message on WhatsApp and we can start planning your arrival."
    message={waMessages.client}
    secondary={{ label: 'Plan My Arrival', href: '/contact/#enquiry' }}
  />
</BaseLayout>
