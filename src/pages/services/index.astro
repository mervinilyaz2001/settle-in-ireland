---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { site } from '../../config/site';
import { services } from '../../data/services';
import { packagePrice } from '../../lib/format';
import { url } from '../../lib/url';

const notDone = [
  { title: 'College admissions', text: 'The partner agency, or the client directly, manages college applications and offers.' },
  { title: 'Visa applications', text: 'The partner agency, or the client directly, manages any visa application before the client travels.' },
  { title: 'Legal or immigration advice', text: 'I give practical guidance only. For advice, please speak to a solicitor or another qualified adviser.' },
  { title: 'Guaranteed appointments', text: 'I never sell, reserve or guarantee IRP, PPSN or any other government appointments.' },
  { title: "Paying fees on the client's behalf", text: 'The client pays government fees, rent, deposits and other third-party costs directly.' },
];
---

<BaseLayout
  title="Arrival and Settling-In Services | Settle in Ireland"
  description="Seven practical services for international clients arriving in Ireland: airport pickup, accommodation, IRP and PPSN guidance, banking and transport."
>
  <PageHero
    eyebrow="Services"
    title="Practical support for the first weeks in Ireland"
    intro="My services cover the practical first weeks in Ireland, starting before the client even travels. From planning the arrival and meeting them at the airport, to registering their immigration permission and getting to know their new area, the client always has a named local contact to turn to."
    crumbs={[{ label: 'Services', href: '/services/' }]}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <WhatsAppButton size="lg" />
      <a href={url('/fees/')} class="btn btn-outline btn-lg">See fees <Icon name="arrow-right" size={20} /></a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="all-services-heading">
    <div class="container-site">
      <h2 id="all-services-heading" class="sr-only">All services</h2>
      <ul class="grid gap-5 md:grid-cols-2">
        {
          services.map((s, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <ServiceCard service={s} variant="detailed" />
            </li>
          ))
        }
        <li data-reveal>
          <div class="flex h-full flex-col justify-center rounded-[16px] border-2 border-dashed border-brand-200 p-7">
            <p class="font-display text-[1.2rem] font-bold text-ink">Not sure what you need?</p>
            <p class="mt-2">Tell me about the client's plans and I will explain how I can help.</p>
            <div class="mt-5">
              <WhatsAppButton />
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="bundle-heading">
    <div class="container-site grid items-start gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <div>
        <SectionHeading
          id="bundle-heading"
          eyebrow="One package"
          title={`All seven services for ${packagePrice} ${site.fee.perUnit}`}
          intro={`The services are bundled into one ${site.fee.title} package, so partner agencies and clients know the full price from the start.`}
        />
        <div class="mt-10 rounded-2xl border border-line bg-canvas p-6 sm:p-7">
          <h3 class="flex items-center gap-3 text-[1.25rem]">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-white text-[#963a2c] shadow-sm"><Icon name="x" size={22} /></span>
            What I don't do
          </h3>
          <ul class="mt-5 grid gap-4">
            {
              notDone.map((item) => (
                <li class="flex gap-3">
                  <Icon name="x" size={18} class="mt-1 shrink-0 text-[#963a2c]" />
                  <span>
                    <strong class="text-ink">{item.title}.</strong> {item.text}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div data-reveal>
        <PriceCard />
      </div>
    </div>
  </section>

  <div class="pt-16 lg:pt-24">
    <CTASection
      title="Ready to plan an arrival?"
      text={`Send me a message on WhatsApp with the client's plans. ${site.responseTime}`}
      secondary={{ label: 'How it works', href: '/how-it-works/' }}
    />
  </div>
</BaseLayout>
