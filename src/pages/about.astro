---
/**
 * ABOUT
 * The owner's name, photo, bio, story, languages and location come from src/config/site.ts.
 * To add a photo, put it in public/images/ (for example public/images/owner.webp, about 800 x 1000
 * pixels) and set ownerPhoto: '/images/owner.webp'. Never add credentials or experience that
 * cannot be backed up.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FounderIntro from '../components/FounderIntro.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Text from '../components/Text.astro';
import { site } from '../config/site';
import { businessSchema } from '../lib/schema';

const values = [
  { icon: 'user-round', title: 'Personal', text: 'You deal with me directly, from the first message to your first weeks in Ireland.' },
  { icon: 'shield-check', title: 'Honest', text: 'I explain what I can and cannot do, and I never promise outcomes that depend on others.' },
  { icon: 'list-checks', title: 'Practical', text: 'Clear steps, simple checklists and links to official sources, in plain English.' },
  { icon: 'whatsapp', title: 'Easy to reach', text: 'Questions are handled on WhatsApp, the app most people moving here already use.' },
];
---

<BaseLayout
  title="About | Settle in Ireland"
  description={`Meet ${site.ownerName}, who runs Settle in Ireland, an independent arrival and settling-in service for people moving to Ireland.`}
>
  <JsonLd slot="head" data={businessSchema()} />

  <PageHero
    eyebrow="About"
    title="A real person in Ireland, on your side"
    intro="Settle in Ireland is a one-person, independent service. When you work with me, you deal with me directly."
    crumbs={[{ label: 'About', href: '/about/' }]}
  />

  <section class="section" aria-label="About the owner">
    <div class="container-site">
      <FounderIntro showAboutLink={false} />
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="how-i-work-heading">
    <div class="container-site">
      <SectionHeading id="how-i-work-heading" eyebrow="How I work" title="Personal, honest and practical" />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <li class="rounded-xl border border-line bg-canvas p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="icon-tile">
                <Icon name={v.icon} size={22} />
              </span>
              <h3 class="mt-4 text-[1.1rem]">{v.title}</h3>
              <p class="mt-2 text-[0.97rem]">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="based-heading">
    <div class="container-site grid items-start gap-8 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading id="based-heading" eyebrow="Where I am based" title="Based in Ireland" />
        <p class="lead mt-5">I am based in <Text value={site.location} />. Airport pickup: {site.airportsCovered}</p>
        <p class="mt-3">In-person help: <Text value={site.inPersonArea} /></p>
      </div>
      <Disclaimer />
    </div>
  </section>

  <CTASection title="Let's talk about your plans" secondary={{ label: 'How it works', href: '/how-it-works/' }} />
</BaseLayout>
