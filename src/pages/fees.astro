---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import PageHero from '../components/PageHero.astro';
import PaymentTimeline from '../components/PaymentTimeline.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Text from '../components/Text.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { services, serviceUrl } from '../data/services';
import { packagePrice } from '../lib/format';
import { businessSchema } from '../lib/schema';
import { waMessages } from '../lib/whatsapp';
import { url } from '../lib/url';

const notIncluded = [
  { icon: 'id-card', text: 'Government fees, for example the IRP registration fee' },
  { icon: 'house', text: 'Rent, accommodation deposits and booking fees' },
  { icon: 'bus', text: 'Transport fares, including Leap Card top-ups' },
  { icon: 'plane-landing', text: site.pickupTransportNote },
  { icon: 'wallet', text: 'Bank charges and fees' },
  { icon: 'smartphone', text: 'Phone and SIM card costs' },
  { icon: 'receipt', text: 'Any other third-party charges' },
];
---

<BaseLayout
  title={`Fees: ${packagePrice} Per Client | Settle in Ireland`}
  description={`One clear fee: ${site.fee.title}, ${packagePrice} per client, paid in two parts. See what is included and which costs are separate.`}
  whatsappMessage={waMessages.fees}
>
  <JsonLd slot="head" data={businessSchema()} />

  <PageHero
    eyebrow="Fees"
    title="One clear, fixed fee"
    intro={`Every client receives the same complete package for ${packagePrice}. Prices are shown openly, so partner agencies and clients know exactly what to expect.`}
    crumbs={[{ label: 'Fees', href: '/fees/' }]}
  >
    <div class="mt-8">
      <WhatsAppButton message={waMessages.fees} size="lg" label="Ask about the package" />
    </div>
  </PageHero>

  <!-- Price card and what is included -->
  <section class="section" aria-labelledby="included-heading">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <div class="lg:sticky lg:top-28" data-reveal>
        <PriceCard showIncluded={false} feesLink={false} headingLevel="h2" />
      </div>
      <div>
        <SectionHeading id="included-heading" eyebrow="What is included" title="All seven services" />
        <ol class="mt-8 grid gap-3">
          {
            services.map((s) => (
              <li>
                <a href={serviceUrl(s)} class="card card-hover flex items-start gap-4 p-5">
                  <span class="icon-tile">
                    <Icon name={s.icon} size={22} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-display font-bold text-ink">{s.name}</span>
                    <span class="mt-1 block text-[0.97rem]">{s.feeLine}</span>
                  </span>
                  <Icon name="chevron-right" size={20} class="ml-auto mt-1 shrink-0 text-brand-300" />
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Payment schedule -->
  <section class="section bg-white" aria-labelledby="schedule-heading">
    <div class="container-site">
      <SectionHeading
        id="schedule-heading"
        eyebrow="Payment schedule"
        title="Paid in two parts"
        intro="The fee is split into two payments, so the client pays as the service moves forward."
      />
      <PaymentTimeline class="mt-10 max-w-4xl" />
    </div>
  </section>

  <section class="section" aria-label="Costs, payment and cancellations">
    <div class="container-site grid gap-6 lg:grid-cols-2">
      <!-- What's not included -->
      <div class="card p-6 sm:p-8 lg:row-span-2">
        <h2 class="text-[1.5rem] sm:text-[1.75rem]">What's not included</h2>
        <p class="mt-2">These costs are paid by the client directly to the provider. They are never part of the {packagePrice} fee.</p>
        <ul class="mt-6 grid gap-3">
          {
            notIncluded.map((item) => (
              <li class="flex items-start gap-3.5 rounded-xl bg-canvas p-3.5">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white text-brand-700 shadow-sm">
                  <Icon name={item.icon} size={18} />
                </span>
                <span class="pt-1.5 text-ink">{item.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- How payment works -->
      <div class="card p-6 sm:p-8">
        <h2 class="flex items-center gap-3 text-[1.35rem]">
          <span class="icon-tile !h-10 !w-10"><Icon name="receipt" size={20} /></span>
          How payment works
        </h2>
        <p class="mt-4"><Text value={site.fee.paymentMethods} /></p>
        <p class="mt-4 rounded-xl bg-brand-50 p-4 text-[0.97rem] text-ink">
          Partner agencies can contact me about how payment and referrals work for their clients.
          <a href={url('/partner-agencies/')} class="font-semibold text-accent-700 underline">Partner Agencies</a>
        </p>
      </div>

      <!-- Refunds and cancellations -->
      <div class="card p-6 sm:p-8">
        <h2 class="flex items-center gap-3 text-[1.35rem]">
          <span class="icon-tile !h-10 !w-10"><Icon name="refresh-cw" size={20} /></span>
          If plans change
        </h2>
        <p class="mt-4"><Text value={site.fee.cancellationPolicy} /></p>
        <a href={url('/terms/#cancellations')} class="text-link mt-2">Read the Terms of Service <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="pb-16 lg:pb-24" aria-label="Independent service">
    <div class="container-site">
      <Disclaimer />
    </div>
  </section>

  <CTASection
    title="Questions about the fee?"
    text={`Send me a message and I will explain how the ${packagePrice} package works for your situation. ${site.responseTime}`}
    message={waMessages.fees}
    secondary={{ label: 'For partner agencies', href: '/partner-agencies/' }}
  />
</BaseLayout>
