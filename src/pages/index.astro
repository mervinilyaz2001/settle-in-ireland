---
/**
 * HOMEPAGE
 * Only the hero, the four services and About us. The package price is deliberately not shown here:
 * it lives on the Moving on Your Own and Education Agencies pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import LogoMark from '../components/LogoMark.astro';
import OfferCards from '../components/OfferCards.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { businessSchema } from '../lib/schema';
import { absoluteUrl, url } from '../lib/url';
import { waLink, waMessages } from '../lib/whatsapp';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: absoluteUrl('/'),
  inLanguage: 'en-IE',
};

const plan = [
  { label: 'Arrival checklist ready', done: true },
  { label: 'Accommodation checked', done: true },
  { label: 'Phone and SIM sorted', done: true },
  { label: 'IRP registration', done: false, next: true },
  { label: 'PPS Number', done: false },
  { label: 'Bank account', done: false },
  { label: 'TFI Leap Card', done: false },
];

const values = [
  { icon: 'user-check', title: 'One-to-one support', text: 'You deal with our team directly, not a call centre.' },
  { icon: 'shield-check', title: 'Honest', text: 'We explain what we can and cannot do, and never sell or promise appointments.' },
  { icon: 'list-checks', title: 'Practical', text: 'Clear steps, simple checklists and links to the official websites.' },
  { icon: 'message-square-text', title: 'Easy to reach', text: 'WhatsApp and phone, and we meet in person only if it is needed.' },
];
---

<BaseLayout
  title="IRP, PPSN & Student Arrival Help | Settle in Ireland"
  description="One-to-one help for international students and education agencies in Ireland: arrival, accommodation, IRP registration and renewal, and PPSN applications."
>
  <JsonLd slot="head" data={[businessSchema(), websiteSchema]} />

  <!-- Hero -->
  <section class="on-dark relative isolate overflow-hidden bg-brand-900 text-white" aria-labelledby="hero-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="hero-glow absolute -left-56 -top-56 h-[640px] w-[640px] rounded-full bg-[radial-gradient(closest-side,rgb(31_138_112/0.35),transparent)]"></div>
      <div class="hero-glow hero-glow-slow absolute -bottom-64 right-[-15%] h-[680px] w-[680px] rounded-full bg-[radial-gradient(closest-side,rgb(42_113_134/0.55),transparent)]"></div>
      <svg class="absolute right-0 top-0 h-full w-full opacity-70 lg:w-[62%]" viewBox="0 0 800 700" preserveAspectRatio="xMaxYMid slice" fill="none">
        <path class="route-dots" d="M-20 640C140 560 210 380 380 360S640 300 760 90" stroke="#2BA585" stroke-opacity=".55" stroke-width="2.5" stroke-dasharray="2 12" stroke-linecap="round"></path>
        <path class="route-dots route-dots-slow" d="M60 720C230 640 330 520 520 500S760 420 840 300" stroke="#8FB7C2" stroke-opacity=".25" stroke-width="2" stroke-dasharray="2 12" stroke-linecap="round"></path>
      </svg>
    </div>

    <div class="container-site grid items-center gap-12 pb-28 pt-12 sm:pb-32 sm:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-40 lg:pt-24">
      <div>
        <p class="eyebrow eyebrow-light hero-in">{site.tagline}</p>
        <h1 id="hero-heading" class="hero-in mt-4 text-[2.5rem] leading-[1.06] !text-white sm:text-6xl lg:text-[4rem]" style="--d:120ms">
          Moving to Ireland? Have someone here <span class="text-gold-300">from day one.</span>
        </h1>
        <p class="lead hero-in mt-6 max-w-[38rem] text-brand-100" style="--d:240ms">
          We help international students and education agencies with the practical side of moving to Ireland: arrival, accommodation, IRP
          registration and renewal, and PPSN applications. One-to-one support from our team in {site.location.split(',')[0]}.
        </p>
        <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" style="--d:360ms">
          <a href={url('/contact/#enquiry')} class="btn btn-gold btn-lg">
            Plan My Arrival <Icon name="arrow-right" size={20} />
          </a>
          <a href="#services" class="btn btn-outline-light btn-lg">Explore Our Services</a>
        </div>
        <p class="hero-in mt-6 text-[0.97rem] text-brand-100" style="--d:460ms">
          Prefer WhatsApp?
          <a
            href={waLink(waMessages.client)}
            target="_blank"
            rel="noopener"
            class="font-semibold text-white underline decoration-wa decoration-2 underline-offset-4 hover:decoration-white"
            data-track-location="hero_text"
            data-lead="individual"
          >
            Message us directly<span class="sr-only"> (opens WhatsApp in a new tab)</span>
          </a>
        </p>
        <ul class="hero-in mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/15 pt-6 text-[0.97rem] font-medium text-brand-100" style="--d:560ms" aria-label="Why choose Settle in Ireland">
          <li class="flex items-center gap-2"><Icon name="user-check" size={20} class="text-accent-300" /> One-to-one support</li>
          <li class="flex items-center gap-2"><Icon name="message-square-text" size={20} class="text-accent-300" /> WhatsApp and phone</li>
          <li class="flex items-center gap-2"><Icon name="map-pin" size={20} class="text-gold-300" /> Based in {site.location.split(',')[0]}</li>
          <li class="flex items-center gap-2"><Icon name="shield-check" size={20} class="text-accent-300" /> Independent service</li>
        </ul>
      </div>

      <!-- Illustration: an example settling-in plan, drawn in code -->
      <div class="hero-card-in relative mx-auto hidden w-full max-w-[440px] sm:block lg:mr-0" aria-hidden="true">
        <div class="float-slow">
          <div class="relative rotate-[1.5deg] rounded-[22px] bg-white p-5 text-body shadow-[0_40px_80px_-30px_rgba(0,0,0,0.6)] sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="icon-tile !h-11 !w-11"><Icon name="list-checks" size={22} /></span>
                <div>
                  <p class="font-display text-[1.05rem] font-bold text-ink">Settling-in plan</p>
                  <p class="text-[0.85rem] text-muted">From before you fly to your first weeks</p>
                </div>
              </div>
              <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[0.72rem] font-bold uppercase tracking-[0.08em] text-brand-700">Example</span>
            </div>
            <ul class="mt-5 grid gap-2">
              {
                plan.map((item, i) => (
                  <li
                    class:list={[
                      'plan-item flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-[0.95rem]',
                      item.next ? 'next-pulse bg-gold-50 ring-1 ring-gold-300' : 'bg-canvas',
                    ]}
                    style={`--d:${700 + i * 110}ms`}
                  >
                    <span class="flex items-center gap-3">
                      <span
                        class:list={[
                          'grid h-6 w-6 place-items-center rounded-full',
                          item.done ? 'check-pop bg-accent-600 text-white' : item.next ? 'border-2 border-gold-500 bg-white' : 'border-2 border-line-strong bg-white',
                        ]}
                        style={`--d:${950 + i * 110}ms`}
                      >
                        {item.done && <Icon name="check" size={14} strokeWidth={3} />}
                      </span>
                      <span class:list={['font-medium', item.done ? 'text-ink' : 'text-body']}>{item.label}</span>
                    </span>
                    {item.next && <span class="text-[0.78rem] font-bold text-gold-800">Next</span>}
                  </li>
                ))
              }
            </ul>
            <div class="mt-5 flex items-center gap-3 border-t border-line pt-4">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-900"><LogoMark size={26} tone="dark" /></span>
              <div class="min-w-0 flex-1">
                <p class="text-[0.92rem] font-semibold text-ink">Your local team in Ireland</p>
                <p class="text-[0.82rem] text-muted">Available on WhatsApp</p>
              </div>
              <span class="grid h-9 w-9 place-items-center rounded-full bg-wa text-wa-ink"><Icon name="whatsapp" size={20} /></span>
            </div>
          </div>
        </div>
        <div class="chip-in absolute -left-3 -top-5 flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-[0.85rem] font-semibold text-ink shadow-lg sm:-left-8" style="--d:1500ms">
          <span class="grid h-6 w-6 place-items-center rounded-full bg-accent-100 text-accent-700"><Icon name="map-pin" size={14} /></span>
          Based in Ireland
        </div>
        <div class="chip-in absolute -bottom-5 -right-2 flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-[0.85rem] font-semibold text-ink shadow-lg sm:-right-6" style="--d:1700ms">
          <span class="grid h-6 w-6 place-items-center rounded-full bg-gold-100 text-gold-800"><Icon name="users" size={14} /></span>
          Family kept updated
        </div>
      </div>
    </div>
  </section>

  <!-- Our services: agencies first, then moving on your own, IRP and PPSN -->
  <section id="services" class="relative z-10 -mt-16 pb-16 sm:-mt-20 lg:pb-24" aria-labelledby="services-heading">
    <div class="container-site">
      <h2 id="services-heading" class="sr-only">Our services</h2>
      <OfferCards />
    </div>
  </section>

  <!-- About us -->
  <section id="about" class="section bg-white" aria-labelledby="about-heading">
    <div class="container-site grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">About us</p>
        <h2 id="about-heading" class="mt-3 text-[1.85rem] sm:text-[2.4rem]">A team in Ireland, helping you get set up</h2>
        <div class="mt-5 grid gap-4 text-[1.05rem] leading-relaxed">
          <p>
            {site.name} is an independent support service based in {site.location}. We help international students, and the education agencies that
            send them, with the practical side of moving to Ireland: planning the arrival, finding somewhere safe to live, and getting set up with IRP
            registration, a PPS Number, a bank account and public transport.
          </p>
          <p>
            {site.supportMode} We already support students from South Asia, and we welcome clients and agencies from any country.
          </p>
          <p>
            We explain each step in plain English and point you to the official websites. We never sell or promise government appointments, and
            official decisions always stay with the authorities.
          </p>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={url('/about/')} class="btn btn-primary">More about us <Icon name="arrow-right" size={18} /></a>
          <WhatsAppButton label="Message us on WhatsApp" track="home_about" />
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          values.map((v, i) => (
            <li class="lift rounded-xl border border-line bg-canvas p-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="icon-tile">
                <Icon name={v.icon} size={22} />
              </span>
              <h3 class="mt-4 text-[1.08rem]">{v.title}</h3>
              <p class="mt-1.5 text-[0.96rem]">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
