---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FounderIntro from '../components/FounderIntro.astro';
import HowItWorksSteps from '../components/HowItWorksSteps.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import LogoMark from '../components/LogoMark.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import WhatToExpect from '../components/WhatToExpect.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { faqsById, homeFaqIds } from '../data/faqs';
import { services } from '../data/services';
import { formatPrice, packagePrice } from '../lib/format';
import { businessSchema } from '../lib/schema';
import { absoluteUrl, url } from '../lib/url';
import { waLink, waMessages } from '../lib/whatsapp';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: absoluteUrl('/'),
  inLanguage: 'en-IE',
};
const [first, second] = site.fee.payments;
const showTestimonials = site.showTestimonials && site.testimonials.length > 0;

const plan = [
  { label: 'Arrival checklist ready', done: true },
  { label: 'Accommodation checked', done: true },
  { label: 'Phone and SIM sorted', done: true },
  { label: 'IRP guidance', done: false, next: true },
  { label: 'PPS Number', done: false },
  { label: 'Bank account', done: false },
  { label: 'TFI Leap Card', done: false },
];
---

<BaseLayout
  title="Arrival Support in Ireland | Settle in Ireland"
  description={`Moving to Ireland? Practical help getting set up, with one local contact: accommodation, IRP and PPS Number guidance, banking and transport. ${packagePrice} per client.`}
>
  <JsonLd slot="head" data={[businessSchema(), websiteSchema]} />

  <!-- Hero -->
  <section class="on-dark relative isolate overflow-hidden bg-brand-900 text-white" aria-labelledby="hero-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="hero-glow absolute -left-56 -top-56 h-[640px] w-[640px] rounded-full bg-[radial-gradient(closest-side,rgb(31_138_112/0.35),transparent)]"></div>
      <div class="hero-glow hero-glow-slow absolute -bottom-64 right-[-15%] h-[680px] w-[680px] rounded-full bg-[radial-gradient(closest-side,rgb(42_113_134/0.55),transparent)]"></div>
      <svg class="absolute right-0 top-0 h-full w-full opacity-70 lg:w-[62%]" viewBox="0 0 800 700" preserveAspectRatio="xMaxYMid slice" fill="none">
        <path class="route-dots" d="M-20 640C140 560 210 380 380 360S640 300 760 90" stroke="#2BA585" stroke-opacity=".55" stroke-width="2.5" stroke-dasharray="2 12" stroke-linecap="round"></path>
        <path class="route-dots route-dots-slow" d="M60 720C230 640 330 520 520 500S760 420 840 300" stroke="#8FB7C2" stroke-opacity=".25" stroke-width="2" stroke-dasharray="2 12" stroke-linecap="round"></path>
      </svg>
    </div>

    <div class="container-site grid items-center gap-12 pb-16 pt-12 sm:pb-20 sm:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-28 lg:pt-24">
      <div>
        <p class="eyebrow eyebrow-light hero-in">{site.tagline}</p>
        <h1 id="hero-heading" class="hero-in mt-4 text-[2.5rem] leading-[1.06] !text-white sm:text-6xl lg:text-[4rem]" style="--d:120ms">
          Moving to Ireland? Have someone here <span class="text-gold-300">from day one.</span>
        </h1>
        <p class="lead hero-in mt-6 max-w-[38rem] text-brand-100" style="--d:240ms">
          Practical, personalised support to help you prepare for arrival and settle into life in Ireland, with a local point of contact to help
          you understand the next steps.
        </p>
        <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" style="--d:360ms">
          <a href={url('/contact/#enquiry')} class="btn btn-gold btn-lg">
            Plan My Arrival <Icon name="arrow-right" size={20} />
          </a>
          <a href={url('/individual-support/')} class="btn btn-outline-light btn-lg">Explore Our Services</a>
        </div>
        <p class="hero-in mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.97rem] text-brand-100" style="--d:460ms">
          <span class="rounded-md bg-white/10 px-2.5 py-1 font-display font-bold text-gold-300">{packagePrice} {site.fee.perUnit}</span>
          <span>
            {site.fee.title}, paid in two parts. Third-party costs are separate.
            <a href={url('/pricing/')} class="font-semibold text-white underline decoration-accent-300 decoration-2 underline-offset-4 hover:decoration-white">See pricing</a>
          </span>
        </p>
        <p class="hero-in mt-4 text-[0.97rem] text-brand-100" style="--d:540ms">
          Prefer WhatsApp?
          <a
            href={waLink(waMessages.client)}
            target="_blank"
            rel="noopener"
            class="font-semibold text-white underline decoration-wa decoration-2 underline-offset-4 hover:decoration-white"
            data-track-location="hero_text"
            data-lead="individual"
          >
            Message me directly<span class="sr-only"> (opens WhatsApp in a new tab)</span>
          </a>
        </p>
        <ul class="hero-in mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/15 pt-6 text-[0.97rem] font-medium text-brand-100" style="--d:620ms" aria-label="Why choose Settle in Ireland">
          <li class="flex items-center gap-2"><Icon name="message-square-text" size={20} class="text-accent-300" /> Support on WhatsApp</li>
          <li class="flex items-center gap-2"><Icon name="badge-euro" size={20} class="text-gold-300" /> {packagePrice}, one clear fee</li>
          <li class="flex items-center gap-2"><Icon name="user-check" size={20} class="text-accent-300" /> One named contact</li>
          <li class="flex items-center gap-2"><Icon name="shield-check" size={20} class="text-accent-300" /> Independent service</li>
        </ul>
      </div>

      <!-- Illustration: an example settling-in plan, drawn in code -->
      <div class="hero-card-in relative mx-auto hidden w-full max-w-[440px] sm:block lg:mr-0" aria-hidden="true">
        <div class="float-slow">
          <div class="relative rotate-[1.5deg] rounded-[22px] bg-white p-5 text-body shadow-[0_40px_80px_-30px_rgba(0,0,0,0.6)] sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="icon-tile !h-11 !w-11"><Icon name="list-checks" size={22} /></span>
                <div>
                  <p class="font-display text-[1.05rem] font-bold text-ink">Settling-in plan</p>
                  <p class="text-[0.85rem] text-muted">From before you fly to your first weeks</p>
                </div>
              </div>
              <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[0.72rem] font-bold uppercase tracking-[0.08em] text-brand-700">Example</span>
            </div>
            <ul class="mt-5 grid gap-2">
              {
                plan.map((item, i) => (
                  <li
                    class:list={[
                      'plan-item flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-[0.95rem]',
                      item.next ? 'next-pulse bg-gold-50 ring-1 ring-gold-300' : 'bg-canvas',
                    ]}
                    style={`--d:${700 + i * 110}ms`}
                  >
                    <span class="flex items-center gap-3">
                      <span
                        class:list={[
                          'grid h-6 w-6 place-items-center rounded-full',
                          item.done ? 'check-pop bg-accent-600 text-white' : item.next ? 'border-2 border-gold-500 bg-white' : 'border-2 border-line-strong bg-white',
                        ]}
                        style={`--d:${950 + i * 110}ms`}
                      >
                        {item.done && <Icon name="check" size={14} strokeWidth={3} />}
                      </span>
                      <span class:list={['font-medium', item.done ? 'text-ink' : 'text-body']}>{item.label}</span>
                    </span>
                    {item.next && <span class="text-[0.78rem] font-bold text-gold-800">Next</span>}
                  </li>
                ))
              }
            </ul>
            <div class="mt-5 flex items-center gap-3 border-t border-line pt-4">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-900"><LogoMark size={26} tone="dark" /></span>
              <div class="min-w-0 flex-1">
                <p class="text-[0.92rem] font-semibold text-ink">Your local contact in Ireland</p>
                <p class="text-[0.82rem] text-muted">Available on WhatsApp</p>
              </div>
              <span class="grid h-9 w-9 place-items-center rounded-full bg-wa text-wa-ink"><Icon name="whatsapp" size={20} /></span>
            </div>
          </div>
        </div>
        <div class="chip-in absolute -left-3 -top-5 flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-[0.85rem] font-semibold text-ink shadow-lg sm:-left-8" style="--d:1500ms">
          <span class="grid h-6 w-6 place-items-center rounded-full bg-accent-100 text-accent-700"><Icon name="map-pin" size={14} /></span>
          Based in Ireland
        </div>
        <div class="chip-in absolute -bottom-5 -right-2 flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-[0.85rem] font-semibold text-ink shadow-lg sm:-right-6" style="--d:1700ms">
          <span class="grid h-6 w-6 place-items-center rounded-full bg-gold-100 text-gold-800"><Icon name="users" size={14} /></span>
          Family kept updated
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container-site">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          id="services-heading"
          eyebrow="How I can help"
          title="Practical help with your first weeks in Ireland"
          intro="Seven services that cover the practical steps of arriving, starting before you travel. All seven are included in one package."
        />
        <a href={url('/individual-support/')} class="text-link shrink-0">All service details <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          services.map((s, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 4) * 60}ms`}>
              <ServiceCard service={s} />
            </li>
          ))
        }
        <li data-reveal>
          <a href={url('/pricing/')} class="on-dark flex h-full flex-col rounded-xl bg-brand-900 p-6 text-white transition-colors hover:bg-brand-800">
            <span class="font-display text-[0.8rem] font-bold uppercase tracking-[0.12em] text-gold-300">One package</span>
            <span class="mt-3 font-display text-[1.6rem] font-bold">{packagePrice}</span>
            <span class="mt-1 text-brand-100">{site.fee.perUnit}, all seven services</span>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-6 font-bold text-gold-300">See pricing <Icon name="arrow-right" size={18} /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section class="section bg-white" aria-label="About the person behind Settle in Ireland">
    <div class="container-site">
      <FounderIntro />
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="steps-heading">
    <div class="container-site">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading id="steps-heading" eyebrow="How it works" title="Four simple steps" intro="No commitment until you have agreed the plan and the price." />
        <a href={url('/how-it-works/')} class="text-link shrink-0">The full process <Icon name="arrow-right" size={18} /></a>
      </div>
      <HowItWorksSteps class="mt-10" />
    </div>
  </section>

  <!-- Pricing -->
  <section class="section bg-sand" aria-labelledby="pricing-heading">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <SectionHeading
          id="pricing-heading"
          eyebrow="Pricing"
          title="One package, one clear price"
          intro={`All seven services for ${packagePrice} ${site.fee.perUnit}. No hidden extras from me.`}
        />
        <dl class="mt-8 grid gap-4">
          <div class="flex gap-4">
            <dt class="icon-tile !bg-white"><Icon name="calendar-check" size={22} /><span class="sr-only">Payment schedule</span></dt>
            <dd>
              <strong class="block font-display text-ink">Paid in two parts</strong>
              {formatPrice(first.amount)} {first.when.charAt(0).toLowerCase() + first.when.slice(1)} {formatPrice(second.amount)}
              {second.when.charAt(0).toLowerCase() + second.when.slice(1)}
            </dd>
          </div>
          <div class="flex gap-4">
            <dt class="icon-tile !bg-white"><Icon name="receipt" size={22} /><span class="sr-only">Costs not included</span></dt>
            <dd>
              <strong class="block font-display text-ink">Third-party costs are separate</strong>
              {site.fee.exclusions} You pay these directly.
            </dd>
          </div>
          <div class="flex gap-4">
            <dt class="icon-tile !bg-white"><Icon name="refresh-cw" size={22} /><span class="sr-only">If plans change</span></dt>
            <dd>
              <strong class="block font-display text-ink">If your plans change</strong>
              See what happens with each payment on the <a href={url('/pricing/')} class="font-semibold text-accent-700 underline">pricing page</a>.
            </dd>
          </div>
        </dl>
      </div>
      <div data-reveal>
        <PriceCard />
      </div>
    </div>
  </section>

  <!-- Testimonials, only when real ones are added; otherwise a transparent "What to expect" -->
  {showTestimonials ? <Testimonials /> : <WhatToExpect />}

  <!-- Agencies -->
  <section class="section" aria-labelledby="agency-teaser-heading">
    <div class="container-site">
      <div class="on-dark relative isolate grid items-center gap-8 overflow-hidden rounded-[24px] bg-brand-950 text-white lg:grid-cols-[1.1fr_0.9fr]" data-reveal="zoom">
        <div aria-hidden="true" class="absolute -right-24 -top-24 -z-10 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgb(31_138_112/0.35),transparent)]"></div>
        <div class="p-7 sm:p-10 lg:p-12">
          <p class="eyebrow eyebrow-light">For education agencies</p>
          <h2 id="agency-teaser-heading" class="mt-3 text-[1.8rem] !text-white sm:text-[2.2rem]">A local point of contact for the students you refer</h2>
          <p class="lead mt-4 text-brand-100">
            Your agency manages admissions and visas. I support your students with the practical steps once they are in Ireland, with an agreed
            scope, process and way of keeping you informed.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={url('/agency-partnerships/')} class="btn btn-lg bg-white text-brand-950 hover:bg-brand-50">
              Agency Partnerships <Icon name="arrow-right" size={20} />
            </a>
            <WhatsAppButton message={waMessages.partnerAgency} label="Message as an agency" size="lg" track="home_agency" lead="agency" />
          </div>
        </div>
        <ol class="grid gap-3 px-7 pb-8 sm:px-10 lg:py-12 lg:pl-0 lg:pr-12" aria-label="How a referral works">
          {
            [
              { icon: 'building', title: 'Your agency handles admission and visa' },
              { icon: 'send', title: 'You refer the student, with their consent' },
              { icon: 'heart-handshake', title: 'I support them in Ireland and keep you updated' },
            ].map((step, i) => (
              <li class="lift-dark flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.05] p-4" data-reveal="right" style={`--reveal-delay:${i * 120}ms`}>
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-white/10 text-gold-300">
                  <Icon name={step.icon} size={22} />
                </span>
                <span class="font-display font-semibold">{step.title}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- FAQ preview -->
  <section class="section bg-white" aria-labelledby="faq-preview-heading">
    <div class="container-site grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <SectionHeading id="faq-preview-heading" eyebrow="FAQs" title="Common questions" intro="Straight answers to the questions people ask most." />
        <a href={url('/faq/')} class="btn btn-outline mt-8">
          See all FAQs <Icon name="arrow-right" size={20} />
        </a>
      </div>
      <FAQAccordion items={faqsById(homeFaqIds)} idPrefix="home-faq" />
    </div>
  </section>

  <div class="pt-16 lg:pt-24">
    <CTASection
      title="Moving to Ireland soon? Let's plan your arrival."
      text="Tell me when you are arriving and what you need. I will explain how I can help and what it costs, before you commit to anything."
      message={waMessages.client}
      secondary={{ label: 'Plan My Arrival', href: '/contact/#enquiry' }}
    />
  </div>
</BaseLayout>
