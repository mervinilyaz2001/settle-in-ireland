---
/**
 * For clients arranging their own move, without an agency.
 * Linked from the homepage hero, the "For Clients" card, the menu and the footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Icon from '../components/Icon.astro';
import OfficialResources from '../components/OfficialResources.astro';
import PageHero from '../components/PageHero.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { official } from '../data/official';
import { services, serviceUrl } from '../data/services';
import type { FAQ } from '../data/types';
import { formatPrice, packagePrice } from '../lib/format';
import { url } from '../lib/url';
import { waMessages } from '../lib/whatsapp';

const [first, second] = site.fee.payments;
const lowerFirst = (text: string) => text.charAt(0).toLowerCase() + text.slice(1);

const youArrange = [
  'Your college or course place, directly with the college or course provider.',
  'Your visa or entry permission, if you need one. This depends on your nationality, and the official Immigration Service Delivery website explains what applies to you.',
  'Your flights and travel insurance.',
  'Fees to your college, and any official fees.',
];

const checklist = [
  {
    icon: 'file-check',
    title: 'Get your place in writing',
    text: 'Keep the letter or email from your college or course provider that confirms your place. You will need it more than once.',
  },
  {
    icon: 'id-card',
    title: 'Check your entry requirements',
    text: 'Look up what applies to your nationality on the Immigration Service Delivery website, including whether you need a visa and what to carry when you arrive.',
  },
  {
    icon: 'house',
    title: 'Start your accommodation search early',
    text: 'Rooms in Dublin go quickly. Never pay a deposit for a place that no one has viewed or checked. I can help you check listings.',
  },
  {
    icon: 'plane',
    title: 'Book your flight and tell me',
    text: 'Send me your flight details once they are booked, so I can plan where and when we meet.',
  },
  {
    icon: 'wallet',
    title: 'Plan your money',
    text: 'Bring a bank card that works abroad and some euro in cash for your first days.',
  },
  {
    icon: 'smartphone',
    title: 'Get your phone ready',
    text: 'Make sure your phone is unlocked for an Irish SIM card, or supports eSIM.',
  },
  {
    icon: 'clipboard-list',
    title: 'Keep one document folder',
    text: 'Passport, college letter, accommodation booking and anything else the official websites ask for, all in your hand luggage.',
  },
];

const steps = [
  {
    title: 'Send me a message',
    text: 'Message me on WhatsApp or use the form below. Tell me where you are coming from and when you plan to arrive.',
  },
  {
    title: 'A short chat',
    text: 'We talk about your plans, and I explain clearly what I can and cannot help with. You pay nothing until you decide to start.',
  },
  {
    title: `${formatPrice(first.amount)} to start`,
    text: 'When you are ready, the first payment starts the service and the planning work begins.',
    payment: true,
  },
  {
    title: 'Planning your arrival',
    text: 'I help with your accommodation search, send you an arrival checklist and plan your airport pickup.',
  },
  {
    title: 'I meet you in Ireland',
    text: 'I meet you at the airport and help you get to your accommodation.',
  },
  {
    title: 'Your first weeks',
    text: `IRP guidance, PPS Number, bank account, Leap Card and local orientation, with WhatsApp support ${site.supportPeriod}. The second payment of ${formatPrice(second.amount)} is due ${lowerFirst(second.when)} ${site.fee.milestoneNote}`,
    payment: true,
  },
];

const reasons = [
  { icon: 'user-check', title: 'A familiar face on day one', text: 'After a long journey, someone you have already spoken to is waiting for you.' },
  { icon: 'shield-check', title: 'Fewer costly mistakes', text: 'Help spotting rental scams, and clear explanations of official processes before you start them.' },
  { icon: 'heart-handshake', title: 'Peace of mind for your family', text: 'Your family knows who is meeting you and who you can turn to.' },
  { icon: 'whatsapp', title: 'Answers when you need them', text: `A real person to message on WhatsApp ${site.supportPeriod}.` },
];

const faqs: (FAQ & { id: string })[] = [
  {
    id: 'no-agency',
    q: 'Can I use Settle in Ireland without an agency?',
    a: '<p>Yes. Anyone can contact me directly, from any country. You do not need to be referred by an agency.</p>',
  },
  {
    id: 'visa-help',
    q: 'Can you help with my visa or college application?',
    a: `<p>No. I do not give immigration or visa advice, and I do not handle visa or college applications. Requirements depend on your nationality, so please check the official <a href="${official.isd.url}" target="_blank" rel="noopener">Immigration Service Delivery website</a>, contact your college directly, or speak to a qualified adviser.</p>`,
  },
  {
    id: 'cost',
    q: 'How much does it cost, and when do I pay?',
    a: `<p>The ${site.fee.title} package is <strong>${packagePrice} ${site.fee.perUnit}</strong>, paid in two parts:</p><ul>${site.fee.payments
      .map((p) => `<li><strong>${formatPrice(p.amount)}:</strong> ${p.when}</li>`)
      .join('')}</ul><p>You pay nothing until you decide to start. ${site.fee.exclusions}</p>`,
  },
  {
    id: 'questions-first',
    q: 'Can I ask questions before I decide?',
    a: '<p>Yes. Send me your questions on WhatsApp. You only pay once you decide to start the service.</p>',
  },
  {
    id: 'family',
    q: 'Can my family be kept updated?',
    a: '<p>Yes. With your agreement, I can keep your family updated, for example to let them know you have arrived safely.</p>',
  },
  {
    id: 'languages',
    q: 'What languages do you speak?',
    a: `<p>I speak ${site.languages}.</p>`,
  },
];
---

<BaseLayout
  title="Moving to Ireland Without an Agency | Settle in Ireland"
  description={`Arranging your own move to Ireland? You can still have a named local contact for airport pickup, accommodation, IRP and PPSN guidance. ${packagePrice} per client.`}
  whatsappMessage={waMessages.direct}
>
  <PageHero
    eyebrow="No agency? No problem."
    title="Moving to Ireland on your own?"
    intro="You do not need an agency to have a local contact in Ireland. If you are arranging your move yourself, I can plan your arrival with you, meet you at the airport and help you through the practical steps of your first weeks."
    crumbs={[{ label: 'Moving on your own', href: '/moving-to-ireland-on-your-own/' }]}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <WhatsAppButton message={waMessages.direct} label="Message me on WhatsApp" size="lg" />
      <a href="#direct-form" class="btn btn-outline btn-lg">
        Tell me about your move <Icon name="arrow-right" size={20} class="rotate-90" />
      </a>
    </div>
    <div slot="aside" class="card p-6 sm:p-7">
      <p class="font-display text-[0.82rem] font-bold uppercase tracking-[0.1em] text-muted">Good to know</p>
      <ul class="mt-4 grid gap-4">
        <li class="flex gap-3">
          <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="globe" size={20} /></span>
          <span><strong class="block text-ink">No agency needed</strong> Contact me directly, from any country.</span>
        </li>
        <li class="flex gap-3">
          <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="badge-euro" size={20} /></span>
          <span><strong class="block text-ink">{packagePrice} {site.fee.perUnit}</strong> One fixed fee, paid in two parts.</span>
        </li>
        <li class="flex gap-3">
          <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="user-check" size={20} /></span>
          <span><strong class="block text-ink">One named contact</strong> The same person from your first message to your first weeks.</span>
        </li>
      </ul>
    </div>
  </PageHero>

  <!-- Who does what -->
  <section class="section" aria-labelledby="split-heading">
    <div class="container-site">
      <SectionHeading
        id="split-heading"
        eyebrow="Who does what"
        title="What you arrange, and what I help with"
        intro="Without an agency, a few things are yours to sort out before you travel. I take care of the practical side once you are on your way."
      />
      <div class="mt-10 grid overflow-hidden rounded-2xl border border-line bg-white shadow-[var(--shadow-soft)] md:grid-cols-2">
        <div>
          <h3 class="flex items-center gap-3 bg-brand-50 px-6 py-4 text-[1.15rem]">
            <Icon name="user-round" size={22} class="text-brand-700" /> You arrange
          </h3>
          <ul class="divide-y divide-line">
            {
              youArrange.map((item) => (
                <li class="flex gap-3 px-6 py-3.5 text-ink">
                  <Icon name="check" size={18} class="mt-1 shrink-0 text-brand-600" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-line md:border-l md:border-t-0">
          <h3 class="flex items-center gap-3 bg-accent-50 px-6 py-4 text-[1.15rem]">
            <Icon name="heart-handshake" size={22} class="text-accent-600" /> I help with
          </h3>
          <ul class="divide-y divide-line">
            {
              services.map((s) => (
                <li>
                  <a href={serviceUrl(s)} class="flex items-center gap-3 px-6 py-3.5 text-ink hover:bg-accent-50">
                    <Icon name="check" size={18} class="shrink-0 text-accent-600" />
                    <span class="flex-1">{s.navName}</span>
                    <Icon name="chevron-right" size={18} class="shrink-0 text-muted" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="mt-6 flex max-w-3xl gap-3 rounded-xl bg-brand-50 p-4 text-[0.97rem] text-ink">
        <Icon name="info" size={20} class="mt-0.5 shrink-0 text-brand-700" />
        <span>
          I do not give immigration or visa advice, and I cannot help with visa or college applications. For those, use the
          <a href={official.isd.url} target="_blank" rel="noopener" class="font-semibold text-accent-700 underline">official Immigration Service Delivery website</a>, contact your college, or speak to a qualified adviser.
        </span>
      </p>
    </div>
  </section>

  <!-- Checklist -->
  <section class="section bg-white" aria-labelledby="checklist-heading">
    <div class="container-site">
      <SectionHeading
        id="checklist-heading"
        eyebrow="Before you travel"
        title="A simple checklist for your move"
        intro="General steps most clients take before moving to Ireland. Requirements change, so always check the official websites."
      />
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          checklist.map((item, i) => (
            <li class="card p-6" data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
              <div class="flex items-center justify-between gap-3">
                <span class="icon-tile">
                  <Icon name={item.icon} size={24} />
                </span>
                <span class="font-display text-[0.85rem] font-bold text-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-5 text-[1.1rem]">{item.title}</h3>
              <p class="mt-2 text-[0.97rem]">{item.text}</p>
            </li>
          ))
        }
        <li class="flex flex-col justify-center rounded-[16px] bg-brand-900 p-6 text-white" data-reveal style="--reveal-delay:210ms">
          <p class="font-display text-[1.15rem] font-bold">Not sure where to start?</p>
          <p class="mt-2 text-brand-100">Send me a message and I will help you put your plan in order.</p>
          <div class="mt-5">
            <WhatsAppButton message={waMessages.direct} label="Ask me on WhatsApp" />
          </div>
        </li>
      </ol>
      <OfficialResources
        class="mt-10"
        title="Official websites for your move"
        resources={[
          { label: official.isd.label, url: official.isd.url, note: 'Entry requirements, visas and registering your immigration permission.' },
          { label: official.ciMovingToIreland.label, url: official.ciMovingToIreland.url, note: 'A plain English official guide to moving to Ireland.' },
          { label: official.rtb.label, url: official.rtb.url, note: 'Official information on renting rights and deposits.' },
        ]}
      />
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="direct-steps-heading">
    <div class="container-site grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          id="direct-steps-heading"
          eyebrow="How it works"
          title="How it works when you come to me directly"
          intro="The same support clients from agencies receive, arranged directly with you."
        />
        <a href={url('/how-it-works/')} class="text-link mt-4">See the full timeline <Icon name="arrow-right" size={18} /></a>
      </div>
      <ol class="relative grid gap-4 before:absolute before:bottom-8 before:left-[27px] before:top-8 before:border-l-2 before:border-dotted before:border-brand-300 sm:before:left-[31px]">
        {
          steps.map((step, i) => (
            <li class:list={['card relative flex gap-4 p-5 sm:gap-5 sm:p-6', step.payment && '!border-gold-300 !bg-gold-50']} data-reveal>
              <span
                class:list={[
                  'relative z-10 grid h-8 w-8 shrink-0 place-items-center rounded-full font-display text-sm font-extrabold sm:h-10 sm:w-10',
                  step.payment ? 'bg-gold-500 text-brand-950' : 'bg-brand-900 text-white',
                ]}
              >
                {step.payment ? <Icon name="euro" size={16} /> : i + 1}
              </span>
              <div>
                <h3 class="text-[1.1rem]">{step.title}</h3>
                <p class="mt-1.5 text-[0.98rem]">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why it helps -->
  <section class="section bg-white" aria-labelledby="why-direct-heading">
    <div class="container-site">
      <SectionHeading
        id="why-direct-heading"
        eyebrow="Why it helps"
        title="Why it helps to have someone here"
        intro="Moving alone is a big step. A local contact makes the first weeks calmer, for you and for your family."
        align="center"
      />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          reasons.map((r, i) => (
            <li class="card p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class:list={['icon-tile', r.icon === 'whatsapp' && '!bg-wa/15 !text-[#0e7a3a]']}>
                <Icon name={r.icon} size={24} />
              </span>
              <h3 class="mt-5 text-[1.12rem]">{r.title}</h3>
              <p class="mt-2 text-[0.97rem]">{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Price and questions -->
  <section class="section" aria-labelledby="direct-faq-heading">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div data-reveal>
        <PriceCard showIncluded={false} />
      </div>
      <div>
        <h2 id="direct-faq-heading" class="text-[1.7rem] sm:text-[2rem]">Questions from clients moving on their own</h2>
        <FAQAccordion items={faqs} idPrefix="direct" schema class="mt-6" />
        <p class="mt-4">
          More answers on the <a href={url('/faq/')} class="font-semibold text-accent-700 underline">FAQ page</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Enquiry form -->
  <section id="direct-form" class="section bg-white" aria-label="Enquiry form">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-14">
      <div class="lg:sticky lg:top-28">
        <SectionHeading
          eyebrow="Get in touch"
          title="Tell me about your move"
          intro="Answer a few questions and your message opens in WhatsApp, ready to send. Prefer to just say hello? Message me directly."
        />
        <div class="mt-6">
          <WhatsAppButton message={waMessages.direct} />
        </div>
        <p class="mt-4 text-[0.95rem] text-muted">{site.responseTime}</p>
      </div>
      <EnquiryForm variant="client" title="Your move to Ireland" intro="Only your name and country are required. Share as much or as little as you like." />
    </div>
  </section>

  <section class="pb-16 pt-16 lg:pb-24 lg:pt-24" aria-label="Independent service">
    <div class="container-site">
      <Disclaimer />
    </div>
  </section>

  <CTASection
    title="Planning your move? Let's talk."
    text={`Send me a message on WhatsApp with your plans and I will explain how I can help. ${site.responseTime}`}
    message={waMessages.direct}
    secondary={{ label: 'See all services', href: '/services/' }}
  />
</BaseLayout>
