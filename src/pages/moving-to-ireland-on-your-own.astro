---
/**
 * MOVING ON YOUR OWN
 * For students, and anyone else, moving to Ireland without an agency: the package, every service in
 * detail, who arranges what, a pre-travel checklist, and the price. The package price is shown here
 * and on the Education Agencies page only, never on the homepage.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Icon from '../components/Icon.astro';
import OfficialResources from '../components/OfficialResources.astro';
import PageHero from '../components/PageHero.astro';
import PaymentTimeline from '../components/PaymentTimeline.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Text from '../components/Text.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { official } from '../data/official';
import { services, serviceUrl, standaloneServices } from '../data/services';
import { packagePrice } from '../lib/format';
import { url } from '../lib/url';
import { waMessages } from '../lib/whatsapp';

const youArrange = [
  'Your college or course place, directly with the college or through an agency.',
  'Your visa or entry permission, if you need one. This depends on your nationality; the official Immigration Service Delivery website explains what applies to you.',
  'Your flights and travel insurance.',
  'Fees to your college, and any official fees.',
];

const checklist = [
  { icon: 'file-check', title: 'Get your place in writing', text: 'Keep the letter or email from your college or course provider that confirms your place.' },
  { icon: 'id-card', title: 'Check your entry requirements', text: 'Look up what applies to your nationality on the Immigration Service Delivery website.' },
  { icon: 'house', title: 'Start your accommodation search early', text: 'Rooms go quickly. Never pay a deposit for a place no one has viewed or checked.' },
  { icon: 'plane', title: 'Share your flight details', text: 'Once your flight is booked, send us the details so we can plan your arrival.' },
  { icon: 'wallet', title: 'Plan your money', text: 'Bring a bank card that works abroad and some euro in cash for your first days.' },
  { icon: 'smartphone', title: 'Get your phone ready', text: 'Make sure your phone is unlocked for an Irish SIM card, or supports eSIM.' },
];

const notIncluded = [
  { icon: 'id-card', text: 'Official fees, for example the IRP registration fee' },
  { icon: 'house', text: 'Rent, accommodation deposits and booking fees' },
  { icon: 'bus', text: 'Transport fares, including Leap Card top-ups' },
  { icon: 'plane-landing', text: 'Taxi or public transport fares from the airport' },
  { icon: 'wallet', text: 'Bank charges and fees' },
  { icon: 'smartphone', text: 'Phone and SIM card costs' },
  { icon: 'receipt', text: 'Any other third-party charges' },
];

const facts = [
  { term: 'Price', value: `${packagePrice} ${site.fee.perUnit}. The price is per person, not per booking.` },
  { term: 'What it covers', value: 'All seven services listed on this page.' },
  { term: 'How support is given', value: site.supportMode },
];
---

<BaseLayout
  title="Moving to Ireland as a Student | Settle in Ireland"
  description={`Moving to Ireland as a student without an agency? One-to-one help with arrival, accommodation, IRP, PPSN, a bank account and transport, for ${packagePrice}.`}
  whatsappMessage={waMessages.direct}
>
  <PageHero
    eyebrow="Moving on your own"
    title="Moving to Ireland as a student, without an agency?"
    intro="Our Moving on Your Own package is for international students, and anyone else, arranging their own move to Ireland. You arrange your college place and visa. We help with everything after that, with one-to-one support before you fly and in your first weeks."
    crumbs={[{ label: 'Moving on Your Own', href: '/moving-to-ireland-on-your-own/' }]}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <a href={url('/contact/#enquiry')} class="btn btn-primary btn-lg">Plan My Arrival</a>
      <WhatsAppButton message={waMessages.direct} size="lg" track="moving_hero" />
    </div>
    <div slot="aside" class="card hero-card-in p-6 sm:p-7">
      <p class="font-display text-[0.82rem] font-bold uppercase tracking-[0.1em] text-muted">Good to know</p>
      <ul class="mt-4 grid gap-4">
        <li class="flex gap-3">
          <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="globe" size={20} /></span>
          <span><strong class="block text-ink">No agency needed</strong> Contact us directly, from any country.</span>
        </li>
        <li class="flex gap-3">
          <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="badge-euro" size={20} /></span>
          <span><strong class="block text-ink">{packagePrice} {site.fee.perUnit}</strong> All seven services, paid in two parts.</span>
        </li>
        <li class="flex gap-3">
          <span class="icon-tile !h-10 !w-10 !rounded-xl"><Icon name="user-check" size={20} /></span>
          <span><strong class="block text-ink">One-to-one support</strong> By WhatsApp and phone, and in person if needed.</span>
        </li>
      </ul>
    </div>
  </PageHero>

  <!-- Only need one service -->
  <section class="border-b border-line bg-white py-8" aria-labelledby="single-heading">
    <div class="container-site flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 id="single-heading" class="text-[1.25rem] sm:text-[1.4rem]">Only need help with your IRP or PPS Number?</h2>
        <p class="mt-1">We can help with just that. Contact us for a price.</p>
      </div>
      <ul class="flex flex-col gap-3 sm:flex-row">
        {
          standaloneServices().map((s) => (
            <li>
              <a href={serviceUrl(s)} class="btn btn-outline w-full sm:w-auto">
                <Icon name={s.icon} size={20} /> {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services in detail -->
  <section class="section" aria-labelledby="services-detail-heading">
    <div class="container-site">
      <SectionHeading
        id="services-detail-heading"
        eyebrow="Services"
        title="What each service includes"
        intro="All seven are included in the Moving on Your Own package. Each one is practical guidance and coordination: official decisions always stay with the relevant authorities."
      />
      <ol class="mt-10 grid gap-5">
        {
          services.map((s) => (
            <li id={s.slug} class="rounded-xl border border-line bg-white p-6 sm:p-8" data-reveal>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-start gap-4">
                  <span class="icon-tile">
                    <Icon name={s.icon} size={24} />
                  </span>
                  <div>
                    <h3 class="text-[1.3rem]">{s.name}</h3>
                    <p class="mt-1.5 max-w-3xl">{s.overview}</p>
                  </div>
                </div>
                <a href={serviceUrl(s)} class="text-link shrink-0">
                  Full details<span class="sr-only">: {s.name}</span> <Icon name="arrow-right" size={18} />
                </a>
              </div>
              <div class="mt-6 grid gap-6 border-t border-line pt-6 md:grid-cols-3">
                <div>
                  <h4 class="text-[0.95rem] font-bold uppercase tracking-[0.06em] text-brand-700">What we help with</h4>
                  <ul class="check-list mt-3 text-[0.96rem]">
                    {s.covers.slice(0, 3).map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="text-[0.95rem] font-bold uppercase tracking-[0.06em] text-brand-700">What you provide</h4>
                  <ul class="mt-3 grid gap-2 text-[0.96rem]">
                    {s.prepare.slice(0, 3).map((p) => (
                      <li class="flex gap-2.5">
                        <span aria-hidden="true" class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                        {p}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="text-[0.95rem] font-bold uppercase tracking-[0.06em] text-brand-700">Limits and costs</h4>
                  <p class="mt-3 text-[0.96rem]">{s.costs}</p>
                  <p class="mt-2 text-[0.96rem]">{s.notIncluded[0]}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <Disclaimer class="mt-8" title="Guidance and coordination, not official decisions" />
    </div>
  </section>

  <!-- Who arranges what -->
  <section class="section bg-white" aria-labelledby="split-heading">
    <div class="container-site">
      <SectionHeading
        id="split-heading"
        eyebrow="Who does what"
        title="What you arrange, and what we help with"
        intro="If an agency is helping you, they handle the first list for you. If not, these are yours to sort out before you travel."
      />
      <div class="mt-10 grid overflow-hidden rounded-xl border border-line bg-white md:grid-cols-2">
        <div>
          <h3 class="flex items-center gap-3 bg-sand px-6 py-4 text-[1.1rem]">
            <Icon name="user-round" size={22} class="text-brand-700" /> You (or your agency) arrange
          </h3>
          <ul class="divide-y divide-line">
            {
              youArrange.map((item) => (
                <li class="flex gap-3 px-6 py-3.5 text-ink">
                  <Icon name="check" size={18} class="mt-1 shrink-0 text-brand-600" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-line md:border-l md:border-t-0">
          <h3 class="flex items-center gap-3 bg-accent-50 px-6 py-4 text-[1.1rem]">
            <Icon name="heart-handshake" size={22} class="text-accent-700" /> We help with
          </h3>
          <ul class="divide-y divide-line">
            {
              services.map((s) => (
                <li>
                  <a href={serviceUrl(s)} class="flex items-center gap-3 px-6 py-3.5 text-ink hover:bg-accent-50">
                    <Icon name="check" size={18} class="shrink-0 text-accent-700" />
                    <span class="flex-1">{s.navName}</span>
                    <Icon name="chevron-right" size={18} class="shrink-0 text-muted" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Checklist -->
  <section class="section" aria-labelledby="checklist-heading">
    <div class="container-site">
      <SectionHeading
        id="checklist-heading"
        eyebrow="Before you travel"
        title="A simple checklist for your move"
        intro="General steps most people take before moving to Ireland. Requirements change, so always check the official websites."
      >
        <a href={url('/moving-to-dublin-as-a-student/')} class="text-link mt-4">
          Read the full step-by-step student guide <Icon name="arrow-right" size={18} />
        </a>
      </SectionHeading>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          checklist.map((item, i) => (
            <li class="lift rounded-xl border border-line bg-white p-6" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
              <span class="icon-tile">
                <Icon name={item.icon} size={22} />
              </span>
              <h3 class="mt-4 text-[1.08rem]">{item.title}</h3>
              <p class="mt-2 text-[0.96rem]">{item.text}</p>
            </li>
          ))
        }
      </ol>
      <OfficialResources
        class="mt-10"
        title="Official websites for your move"
        resources={[
          { label: official.isd.label, url: official.isd.url, note: 'Entry requirements, visas and registering your immigration permission.' },
          { label: official.ciMovingToIreland.label, url: official.ciMovingToIreland.url, note: 'A plain English official guide to moving to Ireland.' },
          { label: official.rtb.label, url: official.rtb.url, note: 'Official information on renting rights and deposits.' },
        ]}
      />
    </div>
  </section>

  <!-- Package and price -->
  <section id="package" class="section bg-sand" aria-labelledby="package-heading">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <SectionHeading
          id="package-heading"
          eyebrow="The package"
          title={`All seven services for ${packagePrice} ${site.fee.perUnit}`}
          intro="One clear price, paid in two parts. You pay nothing until you decide to start, and third-party costs are always separate."
        />
        <dl class="mt-8 grid overflow-hidden rounded-xl border border-line bg-white">
          {
            facts.map((f) => (
              <div class="border-b border-line p-5 last:border-b-0">
                <dt class="font-display font-bold text-ink">{f.term}</dt>
                <dd class="mt-1.5">
                  <Text value={f.value} />
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div data-reveal="zoom">
        <PriceCard showIncluded={false} />
      </div>
    </div>
  </section>

  <!-- Payment schedule -->
  <section class="section" aria-labelledby="schedule-heading">
    <div class="container-site">
      <SectionHeading
        id="schedule-heading"
        eyebrow="Payment schedule"
        title="Paid in two parts"
        intro="The fee is split into two payments as the service moves forward."
      />
      <PaymentTimeline class="mt-10 max-w-4xl" />
      <p class="mt-6 max-w-4xl text-[0.95rem] text-muted">
        IRP appointments are requested by you through the official channels. We cannot promise a specific date or outcome.
      </p>
    </div>
  </section>

  <!-- Not included, and changes -->
  <section class="section bg-white" aria-label="Costs not included, and changes to your plans">
    <div class="container-site grid gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-line bg-canvas p-6 sm:p-8">
        <h2 class="text-[1.5rem] sm:text-[1.7rem]">What's not included</h2>
        <p class="mt-2">You pay these directly to the provider. They are never part of our fee.</p>
        <ul class="mt-6 grid gap-3">
          {
            notIncluded.map((item) => (
              <li class="flex items-start gap-3.5 rounded-lg bg-white p-3.5">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700">
                  <Icon name={item.icon} size={18} />
                </span>
                <span class="pt-1.5 text-ink">{item.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="grid gap-6">
        <div id="changes" class="rounded-xl border border-line bg-canvas p-6 sm:p-8">
          <h2 class="text-[1.4rem]">If your plans change</h2>
          <p class="mt-3"><Text value={site.fee.cancellationPolicy} /></p>
          <a href={url('/terms/#cancellations')} class="text-link mt-2">Read the Terms of Service <Icon name="arrow-right" size={18} /></a>
        </div>
        <div class="rounded-xl border border-line bg-canvas p-6 sm:p-8">
          <h2 class="text-[1.4rem]">Coming through an education agency?</h2>
          <p class="mt-3">
            Students referred by a partner agency get the same seven services. How payment and referrals work is agreed with each agency.
          </p>
          <a href={url('/agency-partnerships/')} class="text-link mt-2">Education Agencies <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
      <Disclaimer class="lg:col-span-2" />
    </div>
  </section>

  <div class="pt-16 lg:pt-24">
    <CTASection
      title="Ready to plan your arrival?"
      text="Tell us about your move and we will explain how we can help, and what it costs, before you commit to anything."
      message={waMessages.direct}
      secondary={{ label: 'Plan My Arrival', href: '/contact/#enquiry' }}
    />
  </div>
</BaseLayout>
