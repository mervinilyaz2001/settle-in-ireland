---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const steps = [
  {
    icon: 'building',
    title: 'Your agency handles admission and visa',
    text: 'The partner agency in the client\'s home country manages the college application and the visa.',
  },
  {
    icon: 'send',
    title: 'Your agency refers the client',
    text: 'With the client\'s consent, the agency shares their details and arrival plans with me.',
  },
  {
    icon: 'heart-handshake',
    title: 'I support the client in Ireland',
    text: 'I become the client\'s named local contact, from arrival planning to their first weeks here.',
  },
];
---

<ol class:list={['grid gap-3 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-stretch lg:gap-4', className]}>
  {
    steps.map((step, i) => (
      <>
        <li class:list={['card relative p-6', i === 2 && 'border-accent-300 bg-accent-50']} data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <div class="flex items-center gap-3">
            <span class:list={['icon-tile', i === 2 && '!bg-white']}>
              <Icon name={step.icon} size={24} />
            </span>
            <span class="font-display text-[0.8rem] font-bold uppercase tracking-[0.1em] text-muted">Step {i + 1}</span>
          </div>
          <h3 class="mt-4 text-[1.15rem]">{step.title}</h3>
          <p class="mt-2 text-[0.97rem]">{step.text}</p>
        </li>
        {i < steps.length - 1 && (
          <li aria-hidden="true" class="grid place-items-center py-1 text-accent-600 lg:py-0">
            <span class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white shadow-sm">
              <Icon name="arrow-right" size={20} class="rotate-90 lg:rotate-0" />
            </span>
          </li>
        )}
      </>
    ))
  }
</ol>
