---
/**
 * Line icons from Lucide (ISC licence). Use by name, for example <Icon name="bus" />.
 * To add an icon, import it below and add it to the list. Browse names at https://lucide.dev/icons
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import BadgeEuro from '@lucide/astro/icons/badge-euro';
import Briefcase from '@lucide/astro/icons/briefcase';
import Building from '@lucide/astro/icons/building';
import Bus from '@lucide/astro/icons/bus';
import CalendarCheck from '@lucide/astro/icons/calendar-check';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import CircleCheck from '@lucide/astro/icons/circle-check';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Clock from '@lucide/astro/icons/clock';
import Compass from '@lucide/astro/icons/compass';
import Euro from '@lucide/astro/icons/euro';
import ExternalLink from '@lucide/astro/icons/external-link';
import FileCheck from '@lucide/astro/icons/file-check';
import FileText from '@lucide/astro/icons/file-text';
import Globe from '@lucide/astro/icons/globe';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Handshake from '@lucide/astro/icons/handshake';
import HeartHandshake from '@lucide/astro/icons/heart-handshake';
import House from '@lucide/astro/icons/house';
import IdCard from '@lucide/astro/icons/id-card';
import Info from '@lucide/astro/icons/info';
import ListChecks from '@lucide/astro/icons/list-checks';
import Lock from '@lucide/astro/icons/lock';
import Luggage from '@lucide/astro/icons/luggage';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Menu from '@lucide/astro/icons/menu';
import MessageSquareText from '@lucide/astro/icons/message-square-text';
import Phone from '@lucide/astro/icons/phone';
import Plane from '@lucide/astro/icons/plane';
import PlaneLanding from '@lucide/astro/icons/plane-landing';
import Plus from '@lucide/astro/icons/plus';
import Receipt from '@lucide/astro/icons/receipt-euro';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import Route from '@lucide/astro/icons/route';
import Send from '@lucide/astro/icons/send';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Smartphone from '@lucide/astro/icons/smartphone';
import Sparkles from '@lucide/astro/icons/sparkles';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import UserCheck from '@lucide/astro/icons/user-check';
import UserRound from '@lucide/astro/icons/user-round';
import Users from '@lucide/astro/icons/users';
import Wallet from '@lucide/astro/icons/wallet';
import X from '@lucide/astro/icons/x';

const icons = {
  'arrow-right': ArrowRight,
  'arrow-up': ArrowUp,
  'badge-check': BadgeCheck,
  'badge-euro': BadgeEuro,
  briefcase: Briefcase,
  building: Building,
  bus: Bus,
  'calendar-check': CalendarCheck,
  check: Check,
  'chevron-down': ChevronDown,
  'chevron-right': ChevronRight,
  'circle-check': CircleCheck,
  'clipboard-list': ClipboardList,
  clock: Clock,
  compass: Compass,
  euro: Euro,
  'external-link': ExternalLink,
  'file-check': FileCheck,
  'file-text': FileText,
  globe: Globe,
  'graduation-cap': GraduationCap,
  handshake: Handshake,
  'heart-handshake': HeartHandshake,
  house: House,
  'id-card': IdCard,
  info: Info,
  'list-checks': ListChecks,
  lock: Lock,
  luggage: Luggage,
  mail: Mail,
  'map-pin': MapPin,
  menu: Menu,
  'message-square-text': MessageSquareText,
  phone: Phone,
  plane: Plane,
  'plane-landing': PlaneLanding,
  plus: Plus,
  receipt: Receipt,
  'refresh-cw': RefreshCw,
  route: Route,
  send: Send,
  'shield-check': ShieldCheck,
  smartphone: Smartphone,
  sparkles: Sparkles,
  'triangle-alert': TriangleAlert,
  'user-check': UserCheck,
  'user-round': UserRound,
  users: Users,
  wallet: Wallet,
  x: X,
} as const;

export type IconName = keyof typeof icons | 'whatsapp';

interface Props {
  name: IconName | string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className, strokeWidth = 1.9 } = Astro.props;
const Component = icons[name as keyof typeof icons];
if (!Component && name !== 'whatsapp') {
  throw new Error(`Icon "${name}" is not in src/components/Icon.astro`);
}
---

{
  name === 'whatsapp' ? (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.24h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z" />
    </svg>
  ) : (
    <Component class={className} size={size} stroke-width={strokeWidth} aria-hidden="true" focusable="false" />
  )
}
