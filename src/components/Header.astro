---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../config/site';
import { services, serviceUrl } from '../data/services';
import { mailHref, telHref } from '../lib/format';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const links = [
  { label: 'Fees', href: '/fees/' },
  { label: 'Partner Agencies', href: '/partner-agencies/' },
  { label: 'How It Works', href: '/how-it-works/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Contact', href: '/contact/' },
];
const mobileLinks = [
  { label: 'Fees', href: '/fees/' },
  { label: 'Partner Agencies', href: '/partner-agencies/' },
  { label: 'Moving Without an Agency', href: '/moving-to-ireland-on-your-own/' },
  { label: 'How It Works', href: '/how-it-works/' },
  { label: 'About', href: '/about/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Contact', href: '/contact/' },
];
const inServices = path.startsWith(url('/services/'));
const current = (href: string) => (path === url(href) ? 'page' : undefined);
---

<header class="site-header sticky top-0 z-40 border-b border-transparent bg-canvas" data-site-header>
  <div class="header-inner container-site flex items-center justify-between gap-4">
    <a href={url('/')} class="flex min-h-11 shrink-0 items-center rounded-lg" aria-label="Settle in Ireland, home">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 xl:gap-1">
        <li class="relative" data-dropdown>
          <button
            type="button"
            class:list={['nav-link', inServices && 'is-current']}
            aria-expanded="false"
            aria-controls="services-menu"
            data-dropdown-trigger
          >
            Services
            <Icon name="chevron-down" size={16} class="transition-transform duration-200" />
          </button>
          <div id="services-menu" class="dropdown-panel" hidden data-dropdown-panel>
            <ul class="grid gap-0.5">
              {
                services.map((s) => (
                  <li>
                    <a href={serviceUrl(s)} class="dropdown-link" aria-current={current(serviceUrl(s))}>
                      <span class="icon-tile !h-9 !w-9 !rounded-[10px]">
                        <Icon name={s.icon} size={18} />
                      </span>
                      <span>{s.navName}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href={url('/services/')} class="mt-2 flex min-h-11 items-center justify-between rounded-xl bg-brand-50 px-4 font-semibold text-brand-900 hover:bg-brand-100" aria-current={current('/services/')}>
              All services <Icon name="arrow-right" size={18} />
            </a>
            <a href={url('/moving-to-ireland-on-your-own/')} class="mt-1 flex min-h-11 items-center justify-between rounded-xl px-4 text-[0.93rem] font-semibold text-accent-700 hover:bg-accent-50" aria-current={current('/moving-to-ireland-on-your-own/')}>
              Moving without an agency? <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} class:list={['nav-link', path === url(l.href) && 'is-current']} aria-current={current(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <WhatsAppButton size="sm" label="WhatsApp" class="hidden sm:inline-flex" labelClass="lg:sr-only xl:not-sr-only" />
      <button
        type="button"
        class="grid h-11 w-11 place-items-center rounded-xl border border-line-strong bg-white text-brand-900 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu" data-mobile-menu>
  <div class="flex min-h-full flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
      <a href={url('/')} class="flex min-h-11 items-center" aria-label="Settle in Ireland, home"><Logo /></a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-xl border border-line-strong text-brand-900" aria-label="Close menu" data-menu-close>
        <Icon name="x" size={24} />
      </button>
    </div>

    <nav aria-label="Mobile" class="flex-1 px-4 py-4">
      <ul class="grid gap-1">
        <li>
          <a href={url('/')} class="mm-link" aria-current={current('/')}>Home</a>
        </li>
        <li>
          <button type="button" class="mm-link w-full justify-between" aria-expanded={inServices ? 'true' : 'false'} aria-controls="mm-services" data-mm-group>
            Services
            <Icon name="chevron-down" size={20} class="transition-transform duration-200" />
          </button>
          <ul id="mm-services" class="mb-2 ml-2 grid gap-0.5 border-l-2 border-accent-100 pl-3" hidden={!inServices}>
            {
              services.map((s) => (
                <li>
                  <a href={serviceUrl(s)} class="mm-sublink" aria-current={current(serviceUrl(s))}>
                    <Icon name={s.icon} size={18} class="shrink-0 text-accent-600" />
                    {s.navName}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={url('/services/')} class="mm-sublink font-semibold text-brand-900" aria-current={current('/services/')}>
                <Icon name="arrow-right" size={18} class="shrink-0 text-accent-600" />
                All services
              </a>
            </li>
          </ul>
        </li>
        {
          mobileLinks.map((l) => (
            <li>
              <a href={url(l.href)} class="mm-link" aria-current={current(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="border-t border-line bg-brand-50 px-4 pb-6 pt-5">
      <WhatsAppButton size="lg" block />
      <div class="mt-3 grid grid-cols-2 gap-2">
        <a href={telHref()} class="btn btn-outline btn-sm"><Icon name="phone" size={18} /> Call</a>
        <a href={mailHref()} class="btn btn-outline btn-sm"><Icon name="mail" size={18} /> Email</a>
      </div>
      <p class="mt-4 text-center text-[0.9rem] text-muted">{site.responseTime}</p>
    </div>
  </div>
</dialog>

<style>
  .header-inner {
    height: 76px;
    transition: height 0.3s var(--ease-out-soft);
  }
  .site-header {
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
  }
  .site-header.is-scrolled {
    border-color: var(--color-line);
    background-color: #fff;
    box-shadow: 0 8px 24px -18px rgb(15 61 76 / 0.35);
  }
  .site-header.is-scrolled .header-inner {
    height: 64px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 10px;
    color: var(--color-ink);
    font-size: 0.96rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    background: none;
    border: 0;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  @media (min-width: 1280px) {
    .nav-link {
      padding: 0 13px;
    }
  }
  .nav-link:hover {
    background: var(--color-brand-50);
    color: var(--color-brand-900);
  }
  .nav-link.is-current {
    color: var(--color-brand-900);
  }
  .nav-link.is-current::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold-500);
  }
  .nav-link[aria-expanded='true'] {
    background: var(--color-brand-50);
  }
  .nav-link[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    left: -8px;
    top: calc(100% + 10px);
    width: 340px;
    padding: 8px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-lift);
  }
  .dropdown-panel::before {
    /* keeps the menu open while the pointer moves from the button to the panel */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }
  .dropdown-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 6px 10px;
    border-radius: 12px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
    text-decoration: none;
  }
  .dropdown-link:hover,
  .dropdown-link[aria-current='page'] {
    background: var(--color-canvas);
    color: var(--color-brand-900);
  }

  .mobile-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 420px);
    height: 100dvh;
    max-height: none;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--color-body);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu::backdrop {
    background: rgb(9 42 53 / 0.55);
    backdrop-filter: blur(2px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 0.35s var(--ease-out-soft);
    }
    .mobile-menu[open]::backdrop {
      animation: fade-in 0.35s ease;
    }
    @keyframes menu-in {
      from {
        transform: translateX(100%);
      }
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }
  .mm-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 12px;
    border-radius: 12px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 700;
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .mm-link:hover,
  .mm-link[aria-current='page'] {
    background: var(--color-brand-50);
    color: var(--color-brand-900);
  }
  .mm-link[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .mm-sublink {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 10px;
    border-radius: 10px;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }
  .mm-sublink:hover,
  .mm-sublink[aria-current='page'] {
    background: var(--color-canvas);
    color: var(--color-brand-900);
  }
</style>

<script>
  /* ---------- Header shrinks a little once the page scrolls ---------- */
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:12px;pointer-events:none;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting)).observe(sentinel);
  }

  /* ---------- Desktop services dropdown ---------- */
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const panel = dropdown.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!trigger || !panel) return;
    let closeTimer: number | undefined;
    let hoverOpenedAt = 0;

    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    trigger.addEventListener('click', () => {
      // A click straight after the pointer opened the menu should keep it open, not close it again
      if (Date.now() - hoverOpenedAt < 600) return;
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });

    const hoverable = window.matchMedia('(hover: hover)');
    dropdown.addEventListener('mouseenter', () => {
      if (!hoverable.matches) return;
      window.clearTimeout(closeTimer);
      if (trigger.getAttribute('aria-expanded') !== 'true') hoverOpenedAt = Date.now();
      setOpen(true);
    });
    dropdown.addEventListener('mouseleave', () => {
      if (!hoverable.matches) return;
      closeTimer = window.setTimeout(() => setOpen(false), 180);
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        trigger.focus();
      }
    });
    dropdown.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !dropdown.contains(next)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) setOpen(false);
    });
  });

  /* ---------- Mobile menu: a modal dialog that traps focus and closes on Escape ---------- */
  const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (menu && openButton && closeButton) {
    const focusable = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((el) => el.offsetParent !== null);

    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      closeButton.focus();
    });
    closeButton.addEventListener('click', () => menu.close());

    menu.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      openButton.focus();
    });

    // Close when tapping the dimmed area outside the panel
    menu.addEventListener('click', (e) => {
      if (e.target === menu) menu.close();
    });

    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusable();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close the menu when a link inside it is used, for example a same-page link
    menu.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => menu.close()));

    // Expandable services group
    menu.querySelectorAll<HTMLButtonElement>('[data-mm-group]').forEach((btn) => {
      const group = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (group) group.hidden = open;
      });
    });

    // Close the menu if the screen becomes wide enough for the desktop navigation
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
