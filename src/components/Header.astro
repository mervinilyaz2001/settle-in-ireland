---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const links = [
  { label: 'Home', href: '/' },
  { label: 'Individual Support', href: '/individual-support/', also: ['/services/'] },
  { label: 'Agency Partnerships', href: '/agency-partnerships/' },
  { label: 'How It Works', href: '/how-it-works/' },
  { label: 'FAQs', href: '/faq/' },
  { label: 'Contact', href: '/contact/' },
];
const mobileExtra = [
  { label: 'Pricing', href: '/pricing/' },
  { label: 'About', href: '/about/' },
];
const isCurrent = (l: { href: string; also?: string[] }) =>
  path === url(l.href) || (l.also ?? []).some((p) => path.startsWith(url(p)));
---

<header class="site-header sticky top-0 z-40 border-b border-line bg-canvas" data-site-header>
  <div class="header-inner container-site flex items-center justify-between gap-4">
    <a href={url('/')} class="flex min-h-11 shrink-0 items-center rounded-lg" aria-label="Settle in Ireland, home">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} class:list={['nav-link', isCurrent(l) && 'is-current']} aria-current={isCurrent(l) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={url('/contact/#enquiry')} class="btn btn-primary btn-sm hidden sm:inline-flex">Plan My Arrival</a>
      <button
        type="button"
        class="grid h-11 w-11 place-items-center rounded-lg border border-line-strong bg-white text-brand-900 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu" data-mobile-menu>
  <div class="flex min-h-full flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
      <a href={url('/')} class="flex min-h-11 items-center" aria-label="Settle in Ireland, home"><Logo /></a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-lg border border-line-strong text-brand-900" aria-label="Close menu" data-menu-close>
        <Icon name="x" size={24} />
      </button>
    </div>

    <nav aria-label="Mobile" class="flex-1 px-4 py-4">
      <ul class="grid gap-1">
        {
          [...links, ...mobileExtra].map((l) => (
            <li>
              <a href={url(l.href)} class="mm-link" aria-current={isCurrent(l) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="grid gap-3 border-t border-line bg-sand px-4 pb-6 pt-5">
      <a href={url('/contact/#enquiry')} class="btn btn-primary btn-lg">Plan My Arrival</a>
      <WhatsAppButton size="lg" block track="mobile_menu" />
    </div>
  </div>
</dialog>

<style>
  .header-inner {
    height: 72px;
    transition: height 0.3s var(--ease-out-soft);
  }
  .site-header {
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }
  .site-header.is-scrolled {
    background-color: #fff;
    box-shadow: 0 6px 18px -14px rgb(23 59 45 / 0.4);
  }
  .site-header.is-scrolled .header-inner {
    height: 62px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .nav-link:hover {
    background: var(--color-brand-50);
    color: var(--color-brand-900);
  }
  .nav-link.is-current {
    color: var(--color-brand-900);
  }
  /* Gold underline: drawn in from the left on hover, always shown for the current page */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out-soft);
  }
  .nav-link:hover::after,
  .nav-link.is-current::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 400px);
    height: 100dvh;
    max-height: none;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--color-body);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu::backdrop {
    background: rgb(15 42 32 / 0.55);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 0.3s var(--ease-out-soft);
    }
    @keyframes menu-in {
      from {
        transform: translateX(100%);
      }
    }
  }
  .mm-link {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none;
  }
  .mm-link:hover,
  .mm-link[aria-current='page'] {
    background: var(--color-brand-50);
    color: var(--color-brand-900);
  }
</style>

<script>
  /* ---------- Header gets a white background and shrinks a little once the page scrolls ---------- */
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:12px;pointer-events:none;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting)).observe(sentinel);
  }

  /* ---------- Mobile menu: a modal dialog that keeps focus inside and closes on Escape ---------- */
  const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (menu && openButton && closeButton) {
    const focusable = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((el) => el.offsetParent !== null);

    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      closeButton.focus();
    });
    closeButton.addEventListener('click', () => menu.close());

    menu.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      openButton.focus();
    });

    // Close when tapping the dimmed area outside the panel
    menu.addEventListener('click', (e) => {
      if (e.target === menu) menu.close();
    });

    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusable();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close the menu when a link inside it is used, for example a same-page link
    menu.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => menu.close()));

    // Close the menu if the screen becomes wide enough for the full navigation
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
