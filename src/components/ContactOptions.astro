---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../config/site';
import { mailHref, telHref } from '../lib/format';

interface Props {
  message?: string;
  class?: string;
}
const { message, class: className } = Astro.props;
---

<div class:list={['grid gap-4', className]}>
  <div class="card relative overflow-hidden p-6 sm:p-7">
    <div aria-hidden="true" class="absolute -right-16 -top-16 h-52 w-52 rounded-full bg-[radial-gradient(closest-side,rgb(37_211_102/0.18),transparent)]"></div>
    <p class="inline-flex items-center gap-2 rounded-full bg-accent-50 px-3 py-1 text-[0.8rem] font-bold text-accent-800">
      <Icon name="sparkles" size={15} /> Quickest way to reach me
    </p>
    <h2 class="mt-4 text-[1.4rem]">WhatsApp</h2>
    <p class="mt-2">Send a message any time. {site.responseTime}</p>
    <div class="mt-5">
      <WhatsAppButton message={message} size="lg" block />
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <a href={telHref()} class="card card-hover flex items-center gap-4 p-5">
      <span class="icon-tile"><Icon name="phone" size={22} /></span>
      <span class="min-w-0">
        <span class="block font-display font-bold text-ink">Call</span>
        <span class="block break-words text-[0.95rem]">{site.phone}</span>
      </span>
    </a>
    <a href={mailHref()} class="card card-hover flex items-center gap-4 p-5">
      <span class="icon-tile"><Icon name="mail" size={22} /></span>
      <span class="min-w-0">
        <span class="block font-display font-bold text-ink">Email</span>
        <span class="block break-all text-[0.95rem]">{site.email}</span>
      </span>
    </a>
  </div>
</div>
