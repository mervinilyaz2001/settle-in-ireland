---
import { site } from '../config/site';
import { formatPrice, packagePrice } from '../lib/format';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const payments = site.fee.payments;
---

<div class={className}>
  <ol class="grid gap-4 sm:grid-cols-2 sm:gap-5">
    {
      payments.map((p, i) => (
        <li class="relative rounded-2xl border border-line bg-white p-5 sm:p-6">
          {i < payments.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute -bottom-4 left-9 h-4 w-0 border-l-2 border-dotted border-brand-300 sm:-right-5 sm:bottom-auto sm:left-auto sm:top-1/2 sm:h-0 sm:w-5 sm:border-l-0 sm:border-t-2"
            />
          )}
          <div class="flex items-center gap-3">
            <span
              class:list={[
                'grid h-9 w-9 shrink-0 place-items-center rounded-full font-display text-sm font-extrabold',
                i === 0 ? 'bg-accent-100 text-accent-800' : 'bg-gold-100 text-gold-800',
              ]}
            >
              {i + 1}
            </span>
            <p class="text-[0.8rem] font-bold uppercase tracking-[0.1em] text-muted">{i === 0 ? 'First payment' : 'Second payment'}</p>
          </div>
          <p class="mt-3 font-display text-3xl font-extrabold text-ink">{formatPrice(p.amount)}</p>
          <p class="mt-1.5 font-medium text-ink">{p.when}</p>
          {i > 0 && (
            <p class="mt-3 flex gap-2 text-[0.92rem] text-muted">
              <span aria-hidden="true" class="mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
              {site.fee.milestoneNote}
            </p>
          )}
        </li>
      ))
    }
  </ol>
  <p class="mt-4 text-[0.97rem]">
    Total: <strong class="text-ink">{packagePrice} {site.fee.perUnit}</strong>. {site.fee.exclusions}
  </p>
</div>
