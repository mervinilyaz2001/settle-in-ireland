---
/**
 * Enquiry forms for individuals and for education agencies.
 *
 * When a form provider is set in src/config/site.ts (forms), the form sends the enquiry to it and
 * the provider emails it to the owner. Until then, the form opens the enquiry in WhatsApp instead,
 * so it never pretends to have sent something it has not. Nothing is stored by the website itself.
 * Spam protection: a hidden "honeypot" field and a minimum time before sending.
 */
import FormField from './FormField.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { url } from '../lib/url';

interface Props {
  variant: 'individual' | 'agency';
  title?: string;
  intro?: string;
}

const { variant, title, intro } = Astro.props;
const f = variant;
const { provider, formspreeId, web3formsKey } = site.forms;
const endpoint =
  provider === 'formspree' && formspreeId
    ? `https://formspree.io/f/${formspreeId}`
    : provider === 'web3forms' && web3formsKey
      ? 'https://api.web3forms.com/submit'
      : null;
const connected = Boolean(endpoint);

const supportChoices = [`${site.fee.title} (all seven services)`, ...services.map((s) => s.name), 'Not sure yet'];
const consentText = 'I agree that Settle in Ireland can use these details to reply to my enquiry.';
const heading =
  variant === 'individual' ? 'New enquiry from the Settle in Ireland website' : 'New agency partnership enquiry from the Settle in Ireland website';
---

<form
  id={`${f}-form`}
  class="card p-5 sm:p-8"
  novalidate
  aria-labelledby={`${f}-form-title`}
  data-enquiry-form
  data-form-type={variant}
  data-provider={connected ? provider : undefined}
  data-endpoint={endpoint ?? undefined}
  data-key={provider === 'web3forms' ? (web3formsKey ?? undefined) : undefined}
  data-wa-number={site.whatsappNumber}
  data-email={site.emailActive ? site.email : undefined}
  data-heading={heading}
  data-subject-prefix={variant === 'individual' ? 'Enquiry from' : 'Agency partnership enquiry from'}
  data-subject-field={variant === 'individual' ? `${f}-name` : `${f}-agency`}
>
  <h2 id={`${f}-form-title`} class="text-[1.5rem] sm:text-[1.7rem]">
    {title ?? (variant === 'individual' ? 'Tell me about your move' : 'Agency partnership enquiry')}
  </h2>
  {intro && <p class="mt-2">{intro}</p>}
  <p class="mt-2 text-[0.93rem] text-muted">Fields marked "required" must be filled in. Everything else is optional.</p>

  <div class="mt-6 rounded-lg border-2 border-[#b42318] bg-[#fef3f2] p-4" tabindex="-1" hidden data-error-summary>
    <p class="font-display font-bold text-[#7a1a12]">Please check the following:</p>
    <ul class="mt-2 list-disc pl-5 text-[0.95rem] text-[#7a1a12]" data-error-list></ul>
  </div>

  <!-- Spam trap: hidden from people, often filled in by bots -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for={`${f}-website-check`}>Leave this field empty</label>
    <input type="text" id={`${f}-website-check`} name="company_url_check" tabindex="-1" autocomplete="off" data-honeypot />
  </div>

  {
    variant === 'individual' ? (
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <FormField id={`${f}-name`} name="name" label="Full name" required autocomplete="name" errorRequired="Please enter your full name." />
        <FormField
          id={`${f}-email`}
          name="email"
          label="Email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          errorRequired="Please enter your email address so I can reply."
        />
        <FormField
          id={`${f}-whatsapp`}
          name="whatsapp"
          label="WhatsApp number"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          hint="Include your country code, for example +55 or +880."
        />
        <FormField id={`${f}-country`} name="country" label="Country you are moving from" autocomplete="country-name" />
        <FormField id={`${f}-arrival`} name="arrival" label="Expected arrival date" type="date" />
        <FormField
          id={`${f}-destination`}
          name="destination"
          label="Where in Ireland are you going?"
          summary="Destination in Ireland"
          hint="For example Dublin, Cork or Galway."
        />

        <fieldset class="sm:col-span-2" data-summary="Accommodation arranged" data-summary-type="radio">
          <legend class="field-label">
            Is your accommodation arranged?<span class="field-hint"> (optional)</span>
          </legend>
          <div class="mt-1 grid gap-3 sm:grid-cols-3">
            {['Yes', 'No', 'Partly or not sure'].map((choice) => (
              <label class="choice">
                <input type="radio" name="accommodation" value={choice} />
                {choice}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="sm:col-span-2" data-summary="Support needed" data-summary-type="checkbox">
          <legend class="field-label">
            What support do you need?<span class="field-hint"> (optional, choose any)</span>
          </legend>
          <div class="mt-1 grid gap-2.5 sm:grid-cols-2">
            {supportChoices.map((choice, i) => (
              <label class:list={['choice', i === 0 && 'sm:col-span-2 font-semibold']}>
                <input type="checkbox" name="support" value={choice} />
                <span>{choice}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <FormField
          id={`${f}-message`}
          name="message"
          label="Message"
          type="textarea"
          maxlength={1500}
          class="sm:col-span-2"
          placeholder="Anything I should know, or any questions you have."
        />
      </div>
    ) : (
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <FormField id={`${f}-agency`} name="agency" label="Agency name" required autocomplete="organization" errorRequired="Please enter your agency's name." />
        <FormField
          id={`${f}-contact`}
          name="contact"
          label="Contact person"
          required
          autocomplete="name"
          errorRequired="Please enter the name of the contact person."
        />
        <FormField
          id={`${f}-email`}
          name="email"
          label="Work email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          errorRequired="Please enter a work email address so I can reply."
        />
        <FormField
          id={`${f}-website`}
          name="website"
          label="Website"
          type="url"
          autocomplete="url"
          inputmode="url"
          placeholder="www.youragency.com"
        />
        <FormField
          id={`${f}-countries`}
          name="countries"
          label="Countries you serve"
          summary="Countries served"
          required
          hint="The countries your students come from."
          errorRequired="Please tell me which countries your students come from."
        />
        <FormField
          id={`${f}-volume`}
          name="volume"
          label="Approximate students referred to Ireland per year"
          summary="Approximate referral volume"
          type="select"
          options={['1 to 10', '11 to 50', '51 to 100', 'More than 100', 'Not sure yet']}
        />
        <FormField
          id={`${f}-message`}
          name="message"
          label="Message"
          type="textarea"
          maxlength={1500}
          class="sm:col-span-2"
          placeholder="Tell me about your agency, your intakes and any questions you have."
        />
      </div>
    )
  }

  <div class="mt-6">
    <label class="choice !items-start !border-line-strong" for={`${f}-consent`}>
      <input
        type="checkbox"
        id={`${f}-consent`}
        name="consent"
        required
        aria-describedby={`${f}-consent-error`}
        data-error-required="Please tick the box so I can use these details to reply to you."
        data-consent={consentText}
        data-label="Consent"
      />
      <span class="text-[0.97rem]">
        {consentText} See the <a href={url('/privacy-policy/')} class="font-semibold text-accent-700 underline">Privacy Policy</a>.
        <span class="field-hint"> (required)</span>
      </span>
    </label>
    <p id={`${f}-consent-error`} class="field-error" hidden data-error></p>
  </div>

  <p class="mt-5 flex gap-2.5 rounded-lg bg-sand p-3.5 text-[0.92rem] text-ink">
    <Icon name="lock" size={18} class="mt-0.5 shrink-0 text-brand-700" />
    <span>
      Please do not include passport numbers, immigration documents, bank details or other sensitive information in this form.
      {connected ? ' Your enquiry is sent securely by email to me.' : ' Pressing the button opens your enquiry in WhatsApp, ready to send.'}
    </span>
  </p>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
    {
      connected ? (
        <button type="submit" class="btn btn-primary btn-lg" data-submit>
          <Icon name="send" size={20} />
          <span data-submit-label>Send enquiry</span>
        </button>
      ) : (
        <button type="submit" class="btn btn-wa btn-lg" data-submit>
          <Icon name="whatsapp" size={24} />
          <span data-submit-label>Send via WhatsApp</span>
        </button>
      )
    }
    {
      site.emailActive && !connected && (
        <button type="button" class="btn btn-outline btn-lg" data-send-email>
          <Icon name="mail" size={20} />
          Send by email instead
        </button>
      )
    }
  </div>

  <!-- Success, shown after sending -->
  <div class="mt-7 rounded-xl border border-accent-300 bg-accent-50 p-5 sm:p-6" tabindex="-1" hidden data-success>
    <p class="flex items-center gap-2.5 font-display text-[1.15rem] font-bold text-ink">
      <Icon name="circle-check" size={24} class="text-accent-700" />
      <span data-success-title></span>
    </p>
    <p class="mt-2" data-success-text></p>
    <div class="mt-4 flex flex-wrap gap-2" data-success-fallback hidden>
      <a class="btn btn-wa btn-sm" href="#" target="_blank" rel="noopener" data-success-wa data-track-location="form_fallback" data-lead={variant}>
        <Icon name="whatsapp" size={18} /> Open WhatsApp again<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <button type="button" class="btn btn-outline btn-sm" data-copy>
        <Icon name="clipboard-list" size={18} /> <span data-copy-label>Copy the message</span>
      </button>
    </div>
  </div>

  <!-- Error, shown if the form provider could not be reached -->
  <div class="mt-7 rounded-xl border-2 border-[#b42318] bg-[#fef3f2] p-5 sm:p-6" tabindex="-1" hidden data-send-error>
    <p class="font-display text-[1.1rem] font-bold text-[#7a1a12]">Sorry, your enquiry could not be sent.</p>
    <p class="mt-2 text-[#7a1a12]">Please try again in a moment, or send it on WhatsApp instead. Your answers are still in the form.</p>
    <a class="btn btn-wa btn-sm mt-4" href="#" target="_blank" rel="noopener" data-error-wa data-track-location="form_error" data-lead={variant}>
      <Icon name="whatsapp" size={18} /> Send on WhatsApp instead<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</form>

<script>
  import { track } from '../scripts/analytics';

  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  const MIN_SECONDS = 2.5;
  const isHidden = (el: Element) => Boolean(el.closest('[hidden]'));

  function errorFor(el: Field): string | null {
    if (isHidden(el) || el.hasAttribute('data-honeypot')) return null;
    if (el instanceof HTMLInputElement && el.type === 'checkbox') {
      return el.required && !el.checked ? (el.dataset.errorRequired ?? 'Please tick this box.') : null;
    }
    const value = el.value.trim();
    if (el.required && !value) return el.dataset.errorRequired ?? 'Please fill in this field.';
    if (!value) return null;
    if (el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
      return 'Please check the email address. It should look like name@example.com.';
    }
    if (el.type === 'tel' && value.replace(/\D/g, '').length < 7) {
      return 'Please check this number. Include the country code, for example +55.';
    }
    if (el.type === 'url' && !/^(https?:\/\/)?[^\s/.]+(\.[^\s/.]+)+(\/\S*)?$/i.test(value)) {
      return 'Please check the website address, for example www.youragency.com.';
    }
    return null;
  }

  function labelText(el: Field): string {
    const label = el.id ? document.querySelector<HTMLLabelElement>(`label[for="${el.id}"]`) : null;
    const text = el.dataset.label || label?.childNodes[0]?.textContent?.trim() || el.dataset.summary || el.name;
    return text.length > 60 ? `${text.slice(0, 57)}...` : text;
  }

  function showError(el: Field, message: string | null) {
    const box = document.getElementById(`${el.id}-error`);
    el.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (!box) return;
    box.textContent = message ?? '';
    box.hidden = !message;
  }

  function formatDate(value: string): string {
    const [y, m, d] = value.split('-').map(Number);
    if (!y || !m || !d) return value;
    return new Intl.DateTimeFormat('en-IE', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(y, m - 1, d));
  }

  /** The answers as label and value pairs, skipping empty optional fields. */
  function answers(form: HTMLFormElement): [string, string][] {
    const out: [string, string][] = [];
    form.querySelectorAll<HTMLElement>('[data-summary]').forEach((node) => {
      if (isHidden(node)) return;
      const label = node.dataset.summary ?? '';
      if (node instanceof HTMLFieldSetElement) {
        const checked = Array.from(node.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
        if (checked.length) out.push([label, checked.join(', ')]);
        return;
      }
      const el = node as Field;
      const value = el.value.trim();
      if (!value) return;
      out.push([label, el instanceof HTMLInputElement && el.type === 'date' ? formatDate(value) : value]);
    });
    return out;
  }

  function summaryText(form: HTMLFormElement): string {
    const lines = [form.dataset.heading ?? 'New enquiry', ''];
    answers(form).forEach(([label, value]) => {
      if (label === 'Message') lines.push('', 'Message:', value);
      else lines.push(`${label}: ${value}`);
    });
    const consent = form.querySelector<HTMLInputElement>('[data-consent]');
    if (consent?.checked) lines.push('', `${consent.dataset.consent}`);
    return lines.join('\n').replace(/\n{3,}/g, '\n\n').trim();
  }

  function validate(form: HTMLFormElement): boolean {
    const fields = Array.from(form.querySelectorAll<Field>('input, select, textarea')).filter(
      (el) => !(el instanceof HTMLInputElement && (el.type === 'radio' || (el.type === 'checkbox' && !el.required))),
    );
    const problems: { el: Field; message: string }[] = [];
    fields.forEach((el) => {
      const message = errorFor(el);
      showError(el, message);
      if (message) problems.push({ el, message });
    });
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const list = form.querySelector<HTMLUListElement>('[data-error-list]');
    if (summary && list) {
      list.replaceChildren(
        ...problems.map(({ el, message }) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${el.id}`;
          a.className = 'underline font-semibold';
          a.textContent = `${labelText(el)}: ${message}`;
          a.addEventListener('click', (e) => {
            e.preventDefault();
            el.focus();
          });
          li.append(a);
          return li;
        }),
      );
      summary.hidden = problems.length === 0;
      if (problems.length) summary.focus();
    }
    return problems.length === 0;
  }

  async function sendToProvider(form: HTMLFormElement, subject: string): Promise<boolean> {
    const provider = form.dataset.provider;
    const endpoint = form.dataset.endpoint;
    if (!endpoint) return false;
    const payload: Record<string, string> = { form_type: form.dataset.formType ?? 'individual' };
    answers(form).forEach(([label, value]) => (payload[label] = value));
    if (provider === 'web3forms') {
      payload.access_key = form.dataset.key ?? '';
      payload.subject = subject;
      payload.from_name = 'Settle in Ireland website';
      payload.botcheck = '';
    } else {
      payload._subject = subject;
      const email = form.querySelector<HTMLInputElement>('input[type="email"]')?.value.trim();
      if (email) payload._replyto = email;
    }
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) return false;
      const data = await res.json().catch(() => ({}));
      return provider === 'web3forms' ? data.success === true : true;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
    const formType = form.dataset.formType ?? 'individual';
    const shownAt = Date.now();
    const success = form.querySelector<HTMLElement>('[data-success]');
    const sendError = form.querySelector<HTMLElement>('[data-send-error]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    let sending = false;

    // Re-check a field once the person leaves it, but only after it has shown an error
    const recheck = (e: Event) => {
      const el = e.target as Field;
      if (el.getAttribute?.('aria-invalid') === 'true') showError(el, errorFor(el));
    };
    form.addEventListener('focusout', recheck);
    form.addEventListener('change', recheck);

    const waUrl = () => `https://wa.me/${form.dataset.waNumber}?text=${encodeURIComponent(summaryText(form))}`;
    const subject = () => {
      const field = document.getElementById(form.dataset.subjectField ?? '') as HTMLInputElement | null;
      return `${form.dataset.subjectPrefix} ${field?.value.trim() ?? ''}`.trim();
    };

    const showSuccess = (title: string, text: string, fallback: boolean) => {
      if (!success) return;
      sendError && (sendError.hidden = true);
      success.querySelector('[data-success-title]')!.textContent = title;
      success.querySelector('[data-success-text]')!.textContent = text;
      const fb = success.querySelector<HTMLElement>('[data-success-fallback]');
      if (fb) fb.hidden = !fallback;
      success.querySelector<HTMLAnchorElement>('[data-success-wa]')?.setAttribute('href', waUrl());
      success.hidden = false;
      success.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending || !validate(form)) return;
      const honeypot = form.querySelector<HTMLInputElement>('[data-honeypot]');
      const tooFast = (Date.now() - shownAt) / 1000 < MIN_SECONDS;
      if (honeypot?.value || tooFast) {
        // Most likely a bot: act as if sent, but send nothing
        showSuccess('Thank you.', 'Your enquiry has been received.', false);
        return;
      }

      if (form.dataset.endpoint) {
        sending = true;
        submit?.setAttribute('aria-disabled', 'true');
        if (submitLabel) submitLabel.textContent = 'Sending...';
        const ok = await sendToProvider(form, subject());
        sending = false;
        submit?.removeAttribute('aria-disabled');
        if (submitLabel) submitLabel.textContent = 'Send enquiry';
        if (ok) {
          track('enquiry_submit', { form: formType, method: 'form' });
          showSuccess('Thank you, your enquiry has been sent.', 'I will reply to the email address you gave. Please check your spam folder if you do not see a reply.', false);
          form.reset();
        } else {
          track('enquiry_error', { form: formType });
          if (sendError) {
            sendError.querySelector<HTMLAnchorElement>('[data-error-wa]')?.setAttribute('href', waUrl());
            success && (success.hidden = true);
            sendError.hidden = false;
            sendError.focus();
          }
        }
        return;
      }

      // No form provider connected yet: hand the enquiry to WhatsApp
      window.open(waUrl(), '_blank', 'noopener');
      track('enquiry_submit', { form: formType, method: 'whatsapp' });
      showSuccess(
        'Almost done. Just press send in WhatsApp.',
        'WhatsApp has opened in a new tab or in the app, with your enquiry ready to send. If nothing opened, use the button below.',
        true,
      );
    });

    form.querySelector('[data-send-email]')?.addEventListener('click', () => {
      if (!validate(form)) return;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject())}&body=${encodeURIComponent(summaryText(form))}`;
      track('enquiry_submit', { form: formType, method: 'email' });
      showSuccess('Almost done. Just press send in your email app.', 'Your email app has opened with your enquiry ready to send.', true);
    });

    form.querySelector('[data-copy]')?.addEventListener('click', async () => {
      const label = form.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(summaryText(form));
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy not available';
      }
    });
  });
</script>
