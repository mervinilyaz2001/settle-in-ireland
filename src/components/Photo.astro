---
/**
 * A responsive photograph from src/data/photos.ts. Astro converts it to AVIF and WebP at several
 * sizes, and the width and height reserve the space so nothing jumps while it loads.
 */
import { Picture } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';

interface Props {
  photo: PhotoKey;
  /** CSS sizes hint, for example '(min-width: 1024px) 50vw, 100vw'. */
  sizes: string;
  /** true for the main image at the top of a page, so it loads first. */
  priority?: boolean;
  showCaption?: boolean;
  class?: string;
  imgClass?: string;
}

const { photo, sizes, priority = false, showCaption = false, class: className, imgClass } = Astro.props;
const p = photos[photo];
---

<figure class:list={['relative overflow-hidden', className]}>
  <Picture
    src={p.src}
    alt={p.alt}
    formats={['avif', 'webp']}
    widths={[480, 768, 1080, 1440]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class:list={['h-full w-full object-cover', imgClass]}
  />
  {
    showCaption && p.caption && (
      <figcaption class="absolute bottom-3 left-3 rounded-md bg-black/55 px-2.5 py-1 text-[0.78rem] font-medium text-white">{p.caption}</figcaption>
    )
  }
</figure>
