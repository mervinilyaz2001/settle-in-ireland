---
/**
 * The Settle in Ireland icon: a location pin with a small house inside and a warm amber door.
 * Original artwork. The same shapes are used in scripts/generate-brand.mjs for the favicons and logo files.
 */
interface Props {
  size?: number;
  /** 'light' for light backgrounds, 'dark' for dark backgrounds. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { size = 40, tone = 'light', class: className } = Astro.props;
const pin = tone === 'light' ? '#0F3D4C' : '#FFFFFF';
const house = tone === 'light' ? '#FFFFFF' : '#0F3D4C';
---

<svg class={className} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <path
    fill={pin}
    d="M24 3.5c-9 0-16.5 7.2-16.5 16.2 0 11.3 12.9 22.8 15.4 24.9a1.7 1.7 0 0 0 2.2 0C27.6 42.5 40.5 31 40.5 19.7 40.5 10.7 33 3.5 24 3.5Z"
  ></path>
  <path fill="#1F8A70" d="M33.6 9.6a14 14 0 0 1 3.6 7.1c-2.6-.4-5-1.8-6.3-4 .9-1.2 1.8-2.2 2.7-3.1Z" opacity=".95"></path>
  <path fill={house} d="M15.6 21.4 24 14.2l8.4 7.2v8.8c0 .7-.5 1.2-1.2 1.2H16.8c-.7 0-1.2-.5-1.2-1.2v-8.8Z"></path>
  <path fill="#F2A541" d="M21.6 31.4v-4.9a2.4 2.4 0 0 1 4.8 0v4.9h-4.8Z"></path>
</svg>
