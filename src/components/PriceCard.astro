---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { formatPrice, packagePrice } from '../lib/format';
import { waMessages } from '../lib/whatsapp';
import { url } from '../lib/url';

interface Props {
  showIncluded?: boolean;
  showPayments?: boolean;
  /** Shows the "See full fee details" link. Turn off on the Fees page itself. */
  feesLink?: boolean;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { showIncluded = true, showPayments = true, feesLink = true, headingLevel = 'h3', class: className } = Astro.props;
const Heading = headingLevel;
---

<div class:list={['card relative overflow-hidden', className]}>
  <div aria-hidden="true" class="h-2 bg-gradient-to-r from-gold-500 via-gold-300 to-gold-500"></div>
  <div class="p-6 sm:p-8">
    <p class="inline-flex items-center gap-2 rounded-full bg-gold-100 px-3 py-1 text-[0.8rem] font-bold text-gold-800">
      <Icon name="badge-euro" size={16} /> One clear, fixed fee
    </p>
    <Heading class="mt-4 text-[1.4rem] sm:text-[1.6rem]">{site.fee.title}</Heading>
    <p class="mt-4 flex items-end gap-2">
      <span class="font-display text-[3.4rem] leading-none font-extrabold tracking-[-0.04em] text-brand-900">{packagePrice}</span>
      <span class="pb-1.5 text-[1.05rem] font-semibold text-muted">{site.fee.perUnit}</span>
    </p>

    {
      showIncluded && (
        <div class="mt-6">
          <p class="font-display font-bold text-ink">What is included</p>
          <ul class="check-list mt-3 text-[0.98rem]">
            {services.map((s) => (
              <li>{s.name}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      showPayments && (
        <div class="mt-6 rounded-xl bg-canvas p-4 sm:p-5">
          <p class="font-display font-bold text-ink">Paid in two parts</p>
          <ul class="mt-3 grid gap-3">
            {site.fee.payments.map((p, i) => (
              <li class="flex gap-3">
                <span
                  class:list={[
                    'h-fit shrink-0 rounded-lg px-2.5 py-1 font-display font-extrabold',
                    i === 0 ? 'bg-accent-100 text-accent-800' : 'bg-gold-100 text-gold-800',
                  ]}
                >
                  {formatPrice(p.amount)}
                </span>
                <span class="pt-0.5 text-[0.97rem] text-ink">{p.when}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-[0.9rem] text-muted">{site.fee.milestoneNote}</p>
        </div>
      )
    }

    <p class="mt-5 flex gap-2.5 text-[0.95rem]">
      <Icon name="info" size={20} class="mt-0.5 shrink-0 text-brand-600" />
      <span>{site.fee.exclusions}</span>
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <WhatsAppButton message={waMessages.fees} label="Ask about the package" track="price_card" />
      {
        feesLink && (
          <a href={url('/pricing/')} class="text-link">
            See full pricing <Icon name="arrow-right" size={18} />
          </a>
        )
      }
    </div>
  </div>
</div>
