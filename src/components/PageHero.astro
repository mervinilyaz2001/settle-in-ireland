---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs: Crumb[];
  /** Puts the slot named "aside" in a second column on large screens. */
  wide?: boolean;
}

const { eyebrow, title, intro, crumbs, wide = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="border-b border-line bg-sand">
  <div class="container-site pb-12 pt-6 sm:pb-16 sm:pt-8 lg:pb-20">
    <Breadcrumbs items={crumbs} />
    <div class:list={['mt-8 sm:mt-10', hasAside && 'grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16']}>
      <div class:list={[wide ? 'max-w-4xl' : 'max-w-3xl']}>
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h1 class="text-[2.2rem] leading-[1.1] sm:text-5xl lg:text-[3.2rem]">{title}</h1>
        {intro && <p class="lead mt-5">{intro}</p>}
        <slot />
      </div>
      {hasAside && <slot name="aside" />}
    </div>
  </div>
</section>
