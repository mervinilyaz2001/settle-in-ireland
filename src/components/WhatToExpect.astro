---
/**
 * A transparent "What to expect" section. Shown instead of testimonials until real,
 * approved testimonials are added in src/config/site.ts.
 */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const items = [
  {
    icon: 'clipboard-list',
    title: 'A clear scope before you pay',
    text: 'You know which of the seven services you get, and which costs are separate, before the first payment.',
  },
  {
    icon: 'user-check',
    title: 'The same person throughout',
    text: 'You message, meet and ask questions of one named contact, not a call centre.',
  },
  {
    icon: 'shield-check',
    title: 'Guidance, not promises I cannot keep',
    text: 'Official decisions stay with the authorities. I help you prepare, and I never sell or guarantee appointments.',
  },
  {
    icon: 'globe',
    title: 'Links to official sources',
    text: 'Fees, rules and processes change, so I always point you to the official Irish websites.',
  },
];
---

<section class="section bg-white" aria-labelledby="expect-heading">
  <div class="container-site">
    <SectionHeading
      id="expect-heading"
      eyebrow="What to expect"
      title="Honest, practical support"
      intro="A clear description of how I work, so you know what you are agreeing to before you start."
    />
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item, i) => (
          <li class="rounded-xl border border-line bg-canvas p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="icon-tile">
              <Icon name={item.icon} size={22} />
            </span>
            <h3 class="mt-4 text-[1.08rem]">{item.title}</h3>
            <p class="mt-2 text-[0.96rem]">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
