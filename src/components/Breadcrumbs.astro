---
import JsonLd from './JsonLd.astro';
import { absoluteUrl, url } from '../lib/url';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  /** Pages between Home and the current page, ending with the current page. Home is added automatically. */
  items: Crumb[];
}

const { items } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: absoluteUrl(crumb.href),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-[0.92rem]">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      trail.map((crumb, i) => {
        const isLast = i === trail.length - 1;
        return (
          <li class="flex items-center gap-2">
            {isLast ? (
              <span aria-current="page" class="font-semibold text-ink">
                {crumb.label}
              </span>
            ) : (
              <>
                <a href={url(crumb.href)} class="inline-flex min-h-11 items-center text-muted underline-offset-4 hover:text-brand-900 hover:underline">
                  {crumb.label}
                </a>
                <span aria-hidden="true" class="text-muted">
                  ›
                </span>
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
<JsonLd data={schema} />
