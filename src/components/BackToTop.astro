---
import Icon from './Icon.astro';
---

<!-- relative z-10: the link tucks into the last section's bottom padding, so it must sit above that section -->
<div class="container-site relative z-10 -mt-6 mb-10 flex justify-start lg:-mt-10 lg:justify-end">
  <a href="#top" class="inline-flex min-h-11 items-center gap-2 rounded-full px-3 text-[0.95rem] font-semibold text-brand-700 underline-offset-4 hover:underline">
    Back to top <Icon name="arrow-up" size={18} />
  </a>
</div>
